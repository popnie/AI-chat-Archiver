        const pn={free:T("free"),plus:T("plus"),pro:T("pro"),team:T("team"),enterprise:T("enterprise")}[userPlanType]||userPlanType;
        const hdr=document.createElement('div');hdr.style.cssText='padding:16px 20px;border-bottom:1px solid #f1f5f9;display:flex;justify-content:space-between;align-items:center;background:#fff;border-radius:20px 20px 0 0;';
        hdr.innerHTML='<div style="display:flex;align-items:center;gap:8px;"><span style="font-weight:800;font-size:14px;color:#0f172a;">'+T("title")+'</span><span style="font-size:10px;background:#f1f5f9;padding:2px 8px;border-radius:6px;color:#64748b;font-weight:700;">'+pn+'</span></div><div style="display:flex;gap:6px;align-items:center;"><button id="lang-toggle-btn" style="background:linear-gradient(135deg,#6366f1,#8b5cf6);color:#fff;border:none;border-radius:6px;padding:2px 10px;font-size:10px;font-weight:700;cursor:pointer;">'+T("langBtn")+'</button><button id="close-x" style="background:none;border:none;cursor:pointer;color:#94a3b8;font-size:22px;line-height:1;">&times;</button></div>';
        const sa=document.createElement('div');sa.className='custom-scrollbar';sa.style.cssText='flex:1;overflow-y:auto;padding:16px 20px;';
        sa.innerHTML='<div id="model-stats-content"></div><div style="margin-top:10px;border-top:1px solid #f1f5f9;padding-top:14px;"><div style="background:linear-gradient(135deg,#fff7ed,#fffbeb);border:1px solid #fdba74;border-radius:12px;padding:12px 14px;margin-bottom:12px;"><div class="zh-dynamic-prompt-hint"></div></div><a href="https://github.com/popnie/AI-chat-Archive" target="_blank" style="display:flex;align-items:center;justify-content:center;gap:10px;text-decoration:none;background:#fff;color:#111827;border:1px solid #d1d5db;border-radius:12px;padding:12px 14px;font-size:13px;font-weight:900;box-shadow:0 10px 20px rgba(15,23,42,.08);"><img src="'+chrome.runtime.getURL('logo/github.png')+'" style="width:16px;height:16px;object-fit:contain;" alt="GitHub">'+(currentLang==='zh'?'喜欢就 + GitHub⭐':'Like it? + GitHub⭐')+'</a></div><div style="display:none;"><select id="folder-select"></select><div id="folder-list-container"></div></div>';initDynamicPromptHints(sa);
        const tools=document.createElement('div');tools.style.cssText='padding:16px 20px;border-top:1px solid #f1f5f9;display:flex;flex-direction:column;gap:10px;background:#fff;';
        const br=document.createElement('div');br.style.display='flex';br.style.gap='10px';
        const ob=document.createElement('button');ob.innerText=T("cleanBtn");const rb=document.createElement('button');rb.innerHTML=T("restoreBtn")+' (<span class="badge">0</span>)';[ob,rb].forEach(b=>{b.style.cssText='flex:1;padding:10px;font-size:12px;border-radius:10px;border:1px solid #e2e8f0;background:#f8fafc;font-weight:700;cursor:pointer;color:#475569;';});rb.style.display='none';rb.style.background='#fff1f2';rb.style.color='#e11d48';ob.onclick=()=>DOMOptimizer.collapse(ob,rb);rb.onclick=()=>DOMOptimizer.restore(ob,rb);br.append(ob,rb);
        // FIX4: Export for ALL platforms
        const eb=document.createElement('button');eb.innerHTML=T("exportBtn");eb.style.cssText='width:100%;padding:14px;background:linear-gradient(135deg,#ef4444,#dc2626);color:#fff;border:none;border-radius:12px;font-weight:800;cursor:pointer;font-size:14px;box-shadow:0 4px 12px rgba(220,38,38,0.25);';eb.onclick=()=>{if(window.gpt_exportChat)window.gpt_exportChat();else exportCurrentConversationFallback();};
        tools.append(br,eb);
        const ft=document.createElement('div');ft.style.cssText='padding:16px 15px;background:#f8fafc;border-radius:0 0 20px 20px;display:flex;justify-content:space-between;align-items:center;border-top:1px solid #f1f5f9;overflow:visible;';
        ft.innerHTML='<a href="https://shiny.zhihuishuju.com/" target="_blank" style="text-decoration:none;text-align:center;display:flex;flex-direction:column;align-items:center;gap:4px;"><img src="https://github.com/popnie/jpg/blob/main/%E5%85%AC%E4%BC%97%E5%8F%B7%2B%E6%99%BA%E8%8D%9Flogo.png?raw=true" style="height:32px;"><div style="font-size:11px;color:#000;font-weight:bold;">'+T("medStat")+'</div></a><div style="text-align:center;display:flex;flex-direction:column;align-items:center;gap:4px;position:relative;"><img class="qr-hover-target" style="width:45px;height:45px;border-radius:12px;border:2px solid #fff;box-shadow:0 2px 8px rgba(0,0,0,0.05);" src="'+chrome.runtime.getURL('buy.png')+'"><div style="font-size:11px;color:#000;font-weight:bold;">'+T("officialAI")+'</div></div><div style="text-align:center;display:flex;flex-direction:column;align-items:center;gap:4px;position:relative;"><img class="qr-hover-target" style="transform-origin:bottom right;width:45px;height:45px;border-radius:12px;border:2px solid #fff;box-shadow:0 2px 8px rgba(0,0,0,0.05);" src="https://github.com/popnie/jpg/blob/main/%E6%88%91%E7%9A%84%E5%85%AC%E4%BC%97%E5%8F%B7%E4%BA%8C%E7%BB%B4%E7%A0%81.jpg?raw=true"><div style="font-size:11px;color:#000;font-weight:bold;">'+T("wxPub")+'</div></div>';
        panel.append(hdr,sa,tools,ft);panel.style.zIndex='2147483647';mini.style.zIndex='2147483647';
        document.documentElement.appendChild(panel);document.documentElement.appendChild(mini);
        if(isPanelCollapsed)panel.style.transform='translateX(calc(100% + 40px))';
        document.getElementById('close-x').onclick=togglePanel;
        document.getElementById('lang-toggle-btn').onclick=()=>{currentLang=currentLang==='zh'?'en':'zh';try{localStorage.setItem('zhihui_lang',currentLang);}catch(e){}applyUIFont();panel.remove();mini.remove();SidebarBookmarks.destroy();createPanel();updateUIContent();VisualTimeline.update();SidebarBookmarks.init();ChatHistoryPanel.destroy();ChatHistoryPanel.init();};
        FM.load();FM.render();
        let uiT=null;new MutationObserver(muts=>{let need=false;for(let m of muts){if(!panel.contains(m.target)){need=true;break;}}if(need){clearTimeout(uiT);uiT=setTimeout(()=>{checkNewQueriesForCounting();updateUIContent();VisualTimeline.update();ChatHistoryPanel.updateList();},800);}}).observe(document.body,{childList:true,subtree:true,characterData:true});
        updateUIContent();VisualTimeline.update();
    }
    window.addEventListener("message",e=>{if(e.source!==window)return;if(e.data?.type==="modelStatsUpdate"){if(e.data.modelStats)modelStats=e.data.modelStats;if(e.data.planType)userPlanType=e.data.planType;loadData();if(e.data.lastRequestTime)lastRequestTime=e.data.lastRequestTime;if(e.data.lastResetTime)lastResetTime=e.data.lastResetTime;updateUIContent();}else if(e.data?.type==="powChange"){if(e.data.difficulty)currentPoW.difficulty=e.data.difficulty;updateUIContent();}else if(e.data?.action==="GPT_OPEN_PREVIEW"){chrome.storage.local.set({gptPreviewHtml:e.data.html},()=>{window.open(chrome.runtime.getURL("preview.html"),"_blank");});}});
    // Fix1: Sidebar push page + resizable + drag-drop
    const SidebarBookmarks={sidebar:null,toggleBtn:null,isOpen:false,
        init(){
            if(document.querySelector('.zh-sidebar'))return;
            this.sidebar=document.createElement('div');this.sidebar.className='zh-sidebar custom-scrollbar zh-floating-ui';
            this.sidebar.innerHTML='';this.sidebar.appendChild(buildSidebarTopContent());initDynamicPromptHints(this.sidebar);this.sidebar.insertAdjacentHTML("beforeend",'<div style="padding:12px 16px 0;flex-shrink:0;"><div style="font-weight:800;font-size:14px;color:#0f172a;margin-bottom:8px;">🗂️ '+T("sidebarFav")+'</div></div><div style="padding:10px 16px;border-bottom:1px solid #f1f5f9;display:flex;gap:6px;flex-shrink:0;"><select id="zh-sb-folder-select" style="flex:1;padding:6px 8px;border:1px solid #e2e8f0;border-radius:8px;font-size:11px;background:#f8fafc;color:#475569;outline:none;"></select><button id="zh-sb-save-btn" style="background:#f59e0b;color:#fff;border:none;border-radius:8px;padding:6px 12px;font-size:11px;font-weight:700;cursor:pointer;">'+T("save")+'</button><button id="zh-sb-export-fav" style="background:#fff;color:#2563eb;border:1px solid #bfdbfe;border-radius:8px;padding:6px 10px;font-size:11px;font-weight:700;cursor:pointer;">'+T("exportFav")+'</button></div><div style="padding:6px 16px;display:flex;gap:6px;flex-shrink:0;"><button id="zh-sb-new-btn" style="flex:1;font-size:11px;background:none;border:1px solid #e2e8f0;border-radius:8px;padding:5px 0;color:#3b82f6;cursor:pointer;font-weight:700;">'+T("newFolder")+'</button></div><div class="custom-scrollbar" id="zh-sb-folders" style="flex:1;overflow-y:auto;padding:8px 16px 16px;"></div><div class="zh-sb-resize"></div>');
            document.documentElement.appendChild(this.sidebar);
            this.toggleBtn=document.createElement('button');this.toggleBtn.className='zh-sb-toggle zh-floating-ui';
            this.toggleBtn.innerHTML='<svg viewBox="0 0 24 24" width="12" height="12" fill="#fff"><path d="M9 18l6-6-6-6"/></svg>';
            document.documentElement.appendChild(this.toggleBtn);
            this.toggleBtn.onclick=()=>this.toggle();
            document.getElementById('zh-sb-cls').onclick=()=>this.close();
            document.getElementById('zh-sb-new-btn').onclick=()=>FM.addFolder();
            document.getElementById('zh-sb-save-btn').onclick=()=>{try{FM.saveChat();const b=document.getElementById('zh-sb-save-btn');b.textContent=T("saved");setTimeout(()=>b.textContent=T("save"),2000);}catch(err){console.error('zh-save-chat-failed',err);alert((currentLang==='zh'?'保存失败，请刷新页面后重试':'Save failed. Please refresh and try again.'));}};
            document.getElementById('zh-sb-export-fav').onclick=()=>{try{FM.exportFolders();const b=document.getElementById('zh-sb-export-fav');const oldText=b.textContent;b.textContent=currentLang==='zh'?'已导出':'Done';setTimeout(()=>{b.textContent=T('exportFav');},1600);}catch(err){console.error('zh-export-folders-failed',err);alert(currentLang==='zh'?'导出失败，请重试':'Export failed. Please try again.');}};
            document.getElementById('zh-side-lang').onclick=()=>{currentLang=currentLang==='zh'?'en':'zh';try{localStorage.setItem('zhihui_lang',currentLang);}catch(e){} applyUIFont(); const p=document.getElementById('model-stats-panel'),m=document.getElementById('model-stats-mini');if(p)p.remove();if(m)m.remove(); SidebarBookmarks.destroy(); ChatHistoryPanel.destroy(); bootStrap();};
            document.getElementById('zh-side-clean').onclick=()=>{const fakeO={style:{display:'block'}};const fakeR={style:{display:'none'},querySelector:()=>({innerText:''})};try{DOMOptimizer.collapse(fakeO,fakeR);}catch(e){console.warn(e);}};
            document.getElementById('zh-side-export').onclick=()=>{if(window.gpt_exportChat)window.gpt_exportChat();else exportCurrentConversationFallback();};
            // Sidebar resize
            let _sr=false,_sw=0,_sx=0;const rh=this.sidebar.querySelector('.zh-sb-resize');
            rh.addEventListener('mousedown',e=>{_sr=true;_sw=this.sidebar.offsetWidth;_sx=e.clientX;e.preventDefault();});
            document.addEventListener('mousemove',e=>{if(!_sr)return;const nw=Math.max(200,Math.min(500,_sw+(e.clientX-_sx)));this.sidebar.style.width=nw+'px';if(this.isOpen){this._applyShift(nw);this.toggleBtn.style.left=nw+'px';}});
            document.addEventListener('mouseup',()=>{_sr=false;});
            this.renderFolders();
            renderSidebarTopContent();
            this.observeConversationList();
            try{if(localStorage.getItem('zh_sidebar_open')==='true')this.open();}catch(e){}
        },
        toggle(){this.isOpen?this.close():this.open();},
        _getShiftTargets(){if(currentPlatform==='deepseek'){const primary=firstExisting(['#root > div:first-child','._7780f2e','#root','main','body > div:first-child']);const main=firstExisting(['main','[class*="conversation"]','[class*="chat"]']);const deepTargets=[];if(primary&&primary!==this.sidebar)deepTargets.push(primary);if(main&&main!==this.sidebar&&!deepTargets.includes(main))deepTargets.push(main);return deepTargets;}const cfg=getNavigatorSiteConfig();const sel=cfg?.selectors?.mainContent;const selectors=Array.isArray(sel)?sel:[sel].filter(Boolean);const found=[];selectors.forEach(ss=>String(ss).split(',').map(v=>v.trim()).filter(Boolean).forEach(s=>{document.querySelectorAll(s).forEach(el=>{if(el&&el!==this.sidebar&&isVisible(el)&&!found.includes(el))found.push(el);});}));if(!found.length){const main=document.querySelector('main');if(main)found.push(main);}return found;},
        _applyShift(w){try{document.body.classList.toggle('zh-sidebar-page-shift',!!w);document.body.style.setProperty('--zh-sidebar-shift',w?(''+w+'px'):'0px');if(currentPlatform==='deepseek'){document.documentElement.classList.toggle('zh-deepseek-shift',!!w);document.documentElement.style.setProperty('--zh-deepseek-shift',w?(''+w+'px'):'0px');return;}else{document.documentElement.classList.remove('zh-deepseek-shift');document.documentElement.style.setProperty('--zh-deepseek-shift','0px');}}catch(e){}this._getShiftTargets().forEach(el=>{el.style.transition='transform 0.3s ease,margin 0.3s ease,width 0.3s ease';el.style.transform='';el.style.marginLeft='';el.style.width='';});},
        open(){this.isOpen=true;this.sidebar?.classList.add('open');const w=this.sidebar.offsetWidth;this._applyShift(w);if(this.toggleBtn){this.toggleBtn.innerHTML='<svg viewBox="0 0 24 24" width="12" height="12" fill="#fff"><path d="M15 18l-6-6 6-6"/></svg>';this.toggleBtn.style.left=w+'px';}try{localStorage.setItem('zh_sidebar_open','true');}catch(e){}},
        close(){this.isOpen=false;this.sidebar?.classList.remove('open');this._applyShift(0);if(this.toggleBtn){this.toggleBtn.innerHTML='<svg viewBox="0 0 24 24" width="12" height="12" fill="#fff"><path d="M9 18l6-6-6-6"/></svg>';this.toggleBtn.style.left='0';}try{localStorage.setItem('zh_sidebar_open','false');}catch(e){}},
        destroy(){try{this._convMo?.disconnect();}catch(e){} this._convMo=null; this.sidebar?.remove();this.sidebar=null;this.toggleBtn?.remove();this.toggleBtn=null;this._applyShift(0);this.isOpen=false;},
        _handleDrop(fn,data){if(!fn)return;let it=null;try{it=typeof data==='string'?JSON.parse(data):data;}catch(e){const raw=String(data||'').trim();if(raw&&/^https?:\/\//i.test(raw)){const title=normalizeConversationTitle(raw.split('/').filter(Boolean).pop()||raw)||T("unnamed");it={id:['conv',currentPlatform,raw,title].join('::'),title,rawTitle:title,url:raw,messageIndex:-1,platform:currentPlatform,source:'sidebar-conversation'};}else if(lastDraggedSidebarItem){it=lastDraggedSidebarItem;}}if(!it&&lastDraggedSidebarItem)it=lastDraggedSidebarItem;if(!it)return;if(!chatFolders[fn])chatFolders[fn]=[];const exists=chatFolders[fn].find(c=>(c.id&&it.id&&c.id===it.id)||((c.url===it.url)&&((c.messageIndex??0)===(it.messageIndex??0))));if(exists)return;chatFolders[fn].unshift(it);openFolderStates[fn]=true;FM.save();FM.render();},
        bindNativeConversationDraggables(scope=document){
            const elements=currentPlatform==='chatgpt'?getChatGPTConversationCandidates(scope):(function(){const selectors=(getConversationDragSelectors()[currentPlatform]||[]).join(',');if(!selectors)return [];const root=scope instanceof Document?scope:(scope instanceof HTMLElement?scope:document);return [...root.querySelectorAll(selectors)];})();
            if(!elements.length)return;
            elements.forEach(el=>{
                const row=findConversationDragRow(el)||el;
                if(!(row instanceof HTMLElement))return;
                if(row.dataset.zhConvDragBound==='1')return;
                row.dataset.zhConvDragBound='1';
                row.setAttribute('draggable','true');
                row.style.webkitUserDrag='element';
                row.addEventListener('dragstart',e=>{
                    const dragPayload=buildSidebarConversationItem(row)||{id:['conv',currentPlatform,getConversationHref(row)||window.location.href,extractConversationTitle(row)].join('::'),title:extractConversationTitle(row)||T("unnamed"),rawTitle:extractConversationTitle(row)||T("unnamed"),url:getConversationHref(row)||window.location.href,messageIndex:-1,platform:currentPlatform,source:'sidebar-conversation'};
                    lastDraggedSidebarItem=dragPayload;
                    try{e.dataTransfer.setData('application/x-zh-chat',JSON.stringify(dragPayload));}catch(err){}
                    try{e.dataTransfer.setData('text/plain',JSON.stringify(dragPayload));}catch(err){}
                    try{e.dataTransfer.setData('text/uri-list',dragPayload.url||window.location.href);}catch(err){}
                    e.dataTransfer.effectAllowed='copy';
                    row.classList.add('dragging');
                    if(!SidebarBookmarks.isOpen)SidebarBookmarks.open();
                });
                row.addEventListener('dragend',()=>row.classList.remove('dragging'));
            });
        },
        initConversationPointerDrag(){
            if(this._pointerDragInit)return;
            this._pointerDragInit=true;
            const state={candidate:null,dragging:false,ghost:null,payload:null,row:null,activeId:null,hoverFolder:null};
            const clearHover=()=>{if(!state.hoverFolder)return;document.querySelectorAll(`[data-zh-folder-target="${CSS.escape(state.hoverFolder)}"]`).forEach(node=>node.classList.remove('drag-over'));state.hoverFolder=null;};
            const setHover=folder=>{if(folder===state.hoverFolder)return;clearHover();if(!folder)return;state.hoverFolder=folder;document.querySelectorAll(`[data-zh-folder-target="${CSS.escape(folder)}"]`).forEach(node=>node.classList.add('drag-over'));};
            const removeGhost=()=>{if(state.ghost){state.ghost.remove();state.ghost=null;}if(state.row)state.row.classList.remove('dragging');document.body.style.userSelect='';clearHover();state.candidate=null;state.dragging=false;state.payload=null;state.row=null;state.activeId=null;};
            const folderAt=(x,y)=>{const el=document.elementFromPoint(x,y);return el?.closest?.('[data-zh-folder-target]')?.dataset?.zhFolderTarget||null;};
            const createGhost=(x,y,title)=>{const g=document.createElement('div');g.className='zh-conv-drag-ghost';g.style.cssText='position:fixed;left:0;top:0;transform:translate(-9999px,-9999px);pointer-events:none;z-index:2147483647;background:rgba(255,255,255,0.96);border:1px solid rgba(245,158,11,0.35);border-radius:12px;padding:8px 12px;box-shadow:0 12px 28px rgba(15,23,42,0.16);font-size:12px;font-weight:800;color:#0f172a;max-width:280px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;';g.textContent='💬 '+(title||T("unnamed"));document.documentElement.appendChild(g);state.ghost=g;g.style.transform=`translate(${x+12}px,${y+12}px)`;};
            document.addEventListener('pointerdown',e=>{if(e.button!==0)return;if(e.target.closest('.zh-floating-ui'))return;let row=findConversationDragRow(e.target);if(!(row instanceof HTMLElement)&&currentPlatform==='chatgpt'){row=getChatGPTConversationCandidates(document).find(candidate=>candidate.contains(e.target))||null;}if(!(row instanceof HTMLElement))return;let payload=buildSidebarConversationItem(row);if(!payload){const fallbackTitle=normalizeConversationTitle(extractReadableText(row))||normalizeConversationTitle(row.textContent)||T("unnamed");const fallbackHref=getConversationHref(row)||window.location.href;payload={id:['conv',currentPlatform,fallbackHref,fallbackTitle].join('::'),title:fallbackTitle,rawTitle:fallbackTitle,url:fallbackHref,messageIndex:-1,platform:currentPlatform,source:'sidebar-conversation'};}state.candidate={x:e.clientX,y:e.clientY};state.payload=payload;state.row=row;state.activeId=e.pointerId;row.setAttribute('draggable','true');},true);
            document.addEventListener('pointermove',e=>{if(state.activeId!==null&&e.pointerId!==state.activeId)return;if(!state.candidate||!state.payload)return;const dx=e.clientX-state.candidate.x,dy=e.clientY-state.candidate.y;if(!state.dragging&&Math.hypot(dx,dy)<8)return;if(!state.dragging){state.dragging=true;lastDraggedSidebarItem=state.payload;state.row?.classList.add('dragging');document.body.style.userSelect='none';createGhost(e.clientX,e.clientY,state.payload.rawTitle||state.payload.title);if(!SidebarBookmarks.isOpen)SidebarBookmarks.open();}if(state.ghost)state.ghost.style.transform=`translate(${e.clientX+12}px,${e.clientY+12}px)`;setHover(folderAt(e.clientX,e.clientY));e.preventDefault();},true);
            const finish=(e)=>{if(state.dragging&&state.payload){const folder=folderAt(e.clientX,e.clientY);if(folder){let freshPayload=state.row?buildSidebarConversationItem(state.row):null;SidebarBookmarks._handleDrop(folder,freshPayload||state.payload);}}removeGhost();};
            document.addEventListener('pointerup',finish,true);
            document.addEventListener('pointercancel',removeGhost,true);
        },
        observeConversationList(){
            try{this.bindNativeConversationDraggables(document);
                this.initConversationPointerDrag();
                const mo=new MutationObserver(ms=>{for(const m of ms){for(const n of m.addedNodes){if(n instanceof HTMLElement){this.bindNativeConversationDraggables(n);}}}});
                mo.observe(document.body,{childList:true,subtree:true});
                this._convMo=mo;
            }catch(e){}
        },
        renderFolders(){
            const c=document.getElementById('zh-sb-folders'),s=document.getElementById('zh-sb-folder-select');if(!c||!s)return;c.innerHTML='';s.innerHTML='';FM.load();
            Object.keys(chatFolders).forEach(fn=>{
                const o=document.createElement('option');o.value=fn;o.innerText=fn;s.appendChild(o);
                const g=document.createElement('div');g.className='folder-group';
                const h=document.createElement('div');h.className='folder-header';h.dataset.zhFolderTarget=fn;g.dataset.zhFolderTarget=fn;h.innerHTML='<span>📁 '+fn+' ('+chatFolders[fn].length+')</span><span style="font-size:9px;color:#94a3b8;">'+T("dragHint")+'</span>';
                const it=document.createElement('div');it.className='folder-items'+(openFolderStates[fn]?' open':'');it.dataset.zhFolderTarget=fn;
                let dragEnterCounter=0;
                h.addEventListener('dragenter',e=>{e.preventDefault();e.stopPropagation();dragEnterCounter++;if(dragEnterCounter===1)h.classList.add('drag-over');});
                h.addEventListener('dragover',e=>{e.preventDefault();e.stopPropagation();e.dataTransfer.dropEffect='copy';h.classList.add('drag-over');});
                h.addEventListener('dragleave',e=>{e.stopPropagation();dragEnterCounter--;if(dragEnterCounter<=0){dragEnterCounter=0;const related=e.relatedTarget;if(!related||!h.contains(related))h.classList.remove('drag-over');}});
                const dropHandler=e=>{e.preventDefault();e.stopPropagation();dragEnterCounter=0;h.classList.remove('drag-over');g.classList.remove('drag-over');it.classList.remove('drag-over');openFolderStates[fn]=true;SidebarBookmarks._handleDrop(fn,e.dataTransfer.getData('application/x-zh-chat')||e.dataTransfer.getData('text/plain')||e.dataTransfer.getData('text/uri-list'));};
                h.addEventListener('drop',dropHandler);
                [g,it].forEach(target=>{target.addEventListener('dragenter',e=>{e.preventDefault();e.stopPropagation();h.classList.add('drag-over');target.classList.add('drag-over');});target.addEventListener('dragover',e=>{e.preventDefault();e.stopPropagation();h.classList.add('drag-over');target.classList.add('drag-over');});target.addEventListener('dragleave',e=>{e.stopPropagation();const rel=e.relatedTarget;if(!rel||!target.contains(rel)){target.classList.remove('drag-over');if(!h.contains(rel))h.classList.remove('drag-over');}});target.addEventListener('drop',dropHandler);});
                h.addEventListener('click',e=>{if(!e.defaultPrevented){openFolderStates[fn]=!openFolderStates[fn];saveFolderState();it.classList.toggle('open',!!openFolderStates[fn]);}});
                chatFolders[fn].forEach((ch,i)=>{
                    const row=document.createElement('div');row.className='chat-link-item';
                    const txt=document.createElement('span');txt.className='chat-link-text';const rowTitle=stripYouSaid(ch.rawTitle||ch.title||T("unnamed"));const rowPrefix=ch.source==='important-message'?'🌟 ':'💬 ';txt.textContent=rowPrefix+(ch.source==='sidebar-conversation'?rowTitle:stripYouSaid(ch.title||ch.rawTitle||T("unnamed"))); 
                    row.appendChild(txt);
                    row.addEventListener('click',ev=>{ev.preventDefault();ev.stopPropagation();if((ch.messageIndex??-1)>=0&&ch.url===window.location.href&&scrollToUserQuery(ch.messageIndex??0))return;window.open(ch.url,'_blank');});
                    const d=document.createElement('button');d.className='chat-delete-btn';d.innerText='✖';
                    d.onclick=ev=>{ev.preventDefault();ev.stopPropagation();if(confirm(T("removeFav").replace("{t}",ch.title||ch.rawTitle||''))){chatFolders[fn].splice(i,1);FM.save();FM.render();}};
                    row.appendChild(d);it.appendChild(row);
                });
                g.appendChild(h);g.appendChild(it);c.appendChild(g);
            });
        }
    };
    // Fix2: Chat History with window-style resize from all edges
    const ChatHistoryPanel={btn:null,panel:null,isVisible:false,
        init(){
            if(document.querySelector('.zh-ch-btn'))return;
            this.btn=document.createElement('button');this.btn.className='zh-ch-btn zh-floating-ui';
            this.btn.innerHTML='<svg viewBox="0 0 24 24" width="15" height="15" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M20 12c0 4.4-3.6 8-8 8-1.4 0-2.7-.4-3.8-1L4 20l1-4.2C4.4 14.7 4 13.4 4 12c0-4.4 3.6-8 8-8s8 3.6 8 8z" fill="#fff7ed" stroke="#fb923c" stroke-width="1.5"/><circle cx="9" cy="12" r="1.2" fill="#fb923c"/><circle cx="12" cy="12" r="1.2" fill="#fb923c"/><circle cx="15" cy="12" r="1.2" fill="#fb923c"/></svg>';
            document.documentElement.appendChild(this.btn);
            this.panel=document.createElement('div');this.panel.className='zh-ch-panel zh-floating-ui';this.panel.style.position='fixed';
            const edges='<div class="zh-ch-edge zh-ch-edge-r" data-dir="r"></div><div class="zh-ch-edge zh-ch-edge-b" data-dir="b"></div><div class="zh-ch-edge zh-ch-edge-l" data-dir="l"></div><div class="zh-ch-edge zh-ch-edge-t" data-dir="t"></div><div class="zh-ch-edge zh-ch-edge-br" data-dir="br"></div><div class="zh-ch-edge zh-ch-edge-bl" data-dir="bl"></div><div class="zh-ch-edge zh-ch-edge-tr" data-dir="tr"></div><div class="zh-ch-edge zh-ch-edge-tl" data-dir="tl"></div>';
            this.panel.innerHTML='<div class="zh-ch-tl" id="zh-ch-tl"></div><div class="zh-ch-list"><div class="zh-ch-hdr"><span>'+T("chatHistoryBtn")+'</span><button id="zh-ch-close" style="background:none;border:none;cursor:pointer;color:#94a3b8;font-size:18px;">&times;</button></div><div class="zh-ch-items custom-scrollbar" id="zh-ch-items"></div></div>'+edges;
            document.documentElement.appendChild(this.panel);
            this.restoreState();
            this.btn.onclick=(e)=>{if(this._btnDragged){this._btnDragged=false;return;}this.toggle();};
            this.panel.querySelector('#zh-ch-close').onclick=()=>this.hide();
            this._initButtonDrag();
            this._initWindowInteractions();
        },
        restoreState(){
            try{const btnState=JSON.parse(localStorage.getItem('zh_ch_btn_state')||'null');if(btnState){if(btnState.left!=null){this.btn.style.left=btnState.left+'px';this.btn.style.top=btnState.top+'px';this.btn.style.right='auto';}}}catch(e){}
            try{const panelState=JSON.parse(localStorage.getItem('zh_ch_panel_state')||'null');if(panelState){if(panelState.left!=null){this.panel.style.left=panelState.left+'px';this.panel.style.top=panelState.top+'px';this.panel.style.right='auto';}if(panelState.width)this.panel.style.width=panelState.width+'px';if(panelState.height)this.panel.style.height=panelState.height+'px';}}catch(e){}
        },
        persistButton(){try{const r=this.btn.getBoundingClientRect();localStorage.setItem('zh_ch_btn_state',JSON.stringify({left:r.left,top:r.top}));}catch(e){}},
        persistPanel(){try{const r=this.panel.getBoundingClientRect();localStorage.setItem('zh_ch_panel_state',JSON.stringify({left:r.left,top:r.top,width:r.width,height:r.height}));}catch(e){}},
        toggle(){this.isVisible?this.hide():this.show();},
        show(){this.isVisible=true;this.panel.classList.add('visible');if(!this.panel.style.left){const br=this.btn.getBoundingClientRect();this.panel.style.left=Math.max(16,br.left-320)+'px';this.panel.style.top=Math.min(window.innerHeight-260,Math.max(16,br.top+36))+'px';this.panel.style.right='auto';}this.updateList();},
        hide(){this.isVisible=false;this.panel.classList.remove('visible');},
        destroy(){this.btn?.remove();this.btn=null;this.panel?.remove();this.panel=null;this.isVisible=false;},
        updateList(){
            if(!this.isVisible)return;const items=document.getElementById('zh-ch-items'),tl=document.getElementById('zh-ch-tl');if(!items||!tl)return;items.innerHTML='';tl.innerHTML='';
            const qs=getUserQueries();if(!qs.length){items.innerHTML='<div style="padding:20px;text-align:center;color:#94a3b8;">-</div>';return;}
            qs.forEach((el,i)=>{
                let raw=stripYouSaid((el.innerText||'').trim().replace(/\n/g,' '));let txt=raw.length>60?raw.substring(0,60)+'...':raw;
                const dot=document.createElement('div');dot.className='dot';if(isMessageImportant(i))dot.style.background='#ef4444';dot.title='Q'+(i+1);dot.onclick=()=>el.scrollIntoView({behavior:'smooth',block:'center'});tl.appendChild(dot);
                const item=document.createElement('div');item.className='zh-ch-item';item.draggable=true;
                item.innerHTML='<span class="idx">'+(i+1)+'</span><span class="txt">'+(txt||T("unnamed"))+'</span>';
                item.onclick=()=>el.scrollIntoView({behavior:'smooth',block:'center'});
                item.addEventListener('dragstart',e=>{item.classList.add('dragging');const payload=buildBookmarkItem(raw||T("unnamed"),i);lastDraggedSidebarItem=payload;e.dataTransfer.setData('text/plain',JSON.stringify(payload));try{e.dataTransfer.setData('application/x-zh-chat',JSON.stringify(payload));}catch(err){}try{e.dataTransfer.setData('text/uri-list',payload.url||window.location.href);}catch(err){}e.dataTransfer.effectAllowed='copy';if(!SidebarBookmarks.isOpen)SidebarBookmarks.open();});
                item.addEventListener('dragend',()=>item.classList.remove('dragging'));
                items.appendChild(item);
            });
        },
        _initButtonDrag(){
            let dragging=false,startX=0,startY=0,baseLeft=0,baseTop=0,activePointerId=null;this._btnDragged=false;
            const move=(clientX,clientY)=>{if(!dragging)return;const dx=clientX-startX,dy=clientY-startY;if(Math.abs(dx)>3||Math.abs(dy)>3)this._btnDragged=true;const maxLeft=Math.max(0,window.innerWidth-this.btn.offsetWidth-8);const maxTop=Math.max(0,window.innerHeight-this.btn.offsetHeight-8);this.btn.style.left=Math.max(0,Math.min(maxLeft,baseLeft+dx))+'px';this.btn.style.top=Math.max(0,Math.min(maxTop,baseTop+dy))+'px';};
            const finish=()=>{if(!dragging)return;dragging=false;activePointerId=null;this.btn.classList.remove('dragging');this.persistButton();};
            this.btn.addEventListener('pointerdown',e=>{dragging=true;activePointerId=e.pointerId;this._btnDragged=false;const r=this.btn.getBoundingClientRect();startX=e.clientX;startY=e.clientY;baseLeft=r.left;baseTop=r.top;this.btn.style.left=r.left+'px';this.btn.style.top=r.top+'px';this.btn.style.right='auto';this.btn.classList.add('dragging');try{this.btn.setPointerCapture(e.pointerId);}catch(err){}e.preventDefault();e.stopPropagation();});
            document.addEventListener('pointermove',e=>{if(activePointerId!==null&&e.pointerId!==activePointerId)return;move(e.clientX,e.clientY);});
            document.addEventListener('pointerup',e=>{if(activePointerId!==null&&e.pointerId!==activePointerId)return;finish();});
            document.addEventListener('pointercancel',finish);
        },
        _initWindowInteractions(){
            const p=this.panel;if(!p)return;const hdr=p.querySelector('.zh-ch-hdr');let mode='',dir='',sx=0,sy=0,sl=0,st=0,sw=0,sh=0;
            hdr.addEventListener('mousedown',e=>{if(e.target.tagName==='BUTTON')return;mode='drag';const rect=p.getBoundingClientRect();sx=e.clientX;sy=e.clientY;sl=rect.left;st=rect.top;p.style.left=rect.left+'px';p.style.top=rect.top+'px';p.style.right='auto';e.preventDefault();});
            p.querySelectorAll('.zh-ch-edge').forEach(edge=>{edge.addEventListener('mousedown',e=>{mode='resize';dir=edge.dataset.dir||'';const rect=p.getBoundingClientRect();sx=e.clientX;sy=e.clientY;sl=rect.left;st=rect.top;sw=rect.width;sh=rect.height;p.style.left=rect.left+'px';p.style.top=rect.top+'px';p.style.width=rect.width+'px';p.style.height=rect.height+'px';p.style.right='auto';e.preventDefault();e.stopPropagation();});});
            document.addEventListener('mousemove',e=>{if(!mode)return;const dx=e.clientX-sx,dy=e.clientY-sy;if(mode==='drag'){const maxLeft=Math.max(0,window.innerWidth-p.offsetWidth-8);const maxTop=Math.max(0,window.innerHeight-p.offsetHeight-8);p.style.left=Math.max(0,Math.min(maxLeft,sl+dx))+'px';p.style.top=Math.max(0,Math.min(maxTop,st+dy))+'px';return;}let nw=sw,nh=sh,nl=sl,nt=st;if(dir.includes('r'))nw=Math.max(260,sw+dx);if(dir.includes('b'))nh=Math.max(220,sh+dy);if(dir.includes('l')){nw=Math.max(260,sw-dx);nl=sl+(sw-nw);}if(dir.includes('t')){nh=Math.max(220,sh-dy);nt=st+(sh-nh);}const maxWidth=Math.min(window.innerWidth-12,900),maxHeight=Math.min(window.innerHeight-12,800);nw=Math.min(nw,maxWidth);nh=Math.min(nh,maxHeight);nl=Math.max(0,Math.min(window.innerWidth-nw-8,nl));nt=Math.max(0,Math.min(window.innerHeight-nh-8,nt));p.style.width=nw+'px';p.style.height=nh+'px';p.style.left=nl+'px';p.style.top=nt+'px';});
            document.addEventListener('mouseup',()=>{if(!mode)return;mode='';dir='';this.persistPanel();});
        }
    };
    // Prompt Library with Lock/Unlock
    const PromptLibrary={panel:null,prompts:[],isLocked:false,
        init(){this.load();if(document.querySelector('.zh-prompt-panel'))return;try{this.isLocked=localStorage.getItem('zh_prompt_locked')==='true';}catch(e){}
            this.panel=document.createElement('div');this.panel.className='zh-prompt-panel zh-floating-ui';
            this.panel.innerHTML='<div class="zh-pp-hdr"><span style="font-weight:800;font-size:14px;color:#0f172a;">'+T("promptLib")+'</span><div style="display:flex;align-items:center;"><button id="zh-pp-lock" class="zh-pp-lock-btn'+(this.isLocked?' locked':'')+'">'+(this.isLocked?T("lockPos"):T("unlockPos"))+'</button><button id="zh-pp-close" style="background:none;border:none;cursor:pointer;color:#94a3b8;font-size:20px;">&times;</button></div></div><div class="zh-pp-add"><input type="text" id="zh-pp-name" placeholder="'+T("promptName")+'"><textarea id="zh-pp-content" placeholder="'+T("promptContent")+'"></textarea><button id="zh-pp-add-btn">'+T("addPrompt")+'</button></div><div class="zh-pp-io-row"><button id="zh-pp-import">'+(currentLang==='zh'?'📥 导入 .md':'📥 Import .md')+'</button><button id="zh-pp-export">'+(currentLang==='zh'?'📤 导出 .md':'📤 Export .md')+'</button></div><div class="zh-pp-list custom-scrollbar" id="zh-pp-list"></div><div class="zh-pp-resize zh-pp-resize-r"></div><div class="zh-pp-resize zh-pp-resize-b"></div><div class="zh-pp-resize zh-pp-resize-l"></div><div class="zh-pp-resize zh-pp-resize-t"></div><div class="zh-pp-resize zh-pp-resize-br"></div><div class="zh-pp-resize zh-pp-resize-bl"></div><div class="zh-pp-resize zh-pp-resize-tr"></div><div class="zh-pp-resize zh-pp-resize-tl"></div>';
            document.documentElement.appendChild(this.panel);
            try{const p=JSON.parse(localStorage.getItem('zh_prompt_pos'));if(p){this.panel.style.top=p.t;this.panel.style.left=p.l;if(p.w)this.panel.style.width=p.w;if(p.h){this.panel.style.height=p.h;this.panel.style.maxHeight='none';}this.panel.style.right='auto';}}catch(e){}
            document.getElementById('zh-pp-close').onclick=()=>this.hide();
            document.getElementById('zh-pp-add-btn').onclick=()=>this.addPrompt();
            document.getElementById('zh-pp-lock').onclick=()=>this.toggleLock();
            document.getElementById('zh-pp-import').onclick=()=>this._importMD();
            document.getElementById('zh-pp-export').onclick=()=>this._exportMD();
            this._initDrag();this._initResize();this.renderList();
        },
        _initDrag(){const h=this.panel?.querySelector('.zh-pp-hdr');if(!h)return;let dr=false,sx,sy,ox,oy;h.style.cursor=this.isLocked?'default':'move';
            h.addEventListener('mousedown',e=>{if(this.isLocked||e.target.tagName==='BUTTON')return;dr=true;sx=e.clientX;sy=e.clientY;const r=this.panel.getBoundingClientRect();ox=r.left;oy=r.top;e.preventDefault();});
            document.addEventListener('mousemove',e=>{if(!dr)return;this.panel.style.left=(ox+(e.clientX-sx))+'px';this.panel.style.top=(oy+(e.clientY-sy))+'px';this.panel.style.right='auto';});
            document.addEventListener('mouseup',()=>{if(dr){dr=false;this._persistPos();}});
        },
        _initResize(){const p=this.panel;if(!p)return;let mode='',dir='',sx=0,sy=0,sl=0,st=0,sw=0,sh=0;
            p.querySelectorAll('.zh-pp-resize').forEach(handle=>{handle.addEventListener('mousedown',e=>{mode='resize';const cls=handle.className||'';dir=cls.replace(/.*zh-pp-resize-/,'').split(' ')[0]||'';const rect=p.getBoundingClientRect();sx=e.clientX;sy=e.clientY;sl=rect.left;st=rect.top;sw=rect.width;sh=rect.height;p.style.left=rect.left+'px';p.style.top=rect.top+'px';p.style.width=rect.width+'px';p.style.height=rect.height+'px';p.style.maxHeight='none';p.style.right='auto';e.preventDefault();e.stopPropagation();});});
            document.addEventListener('mousemove',e=>{if(mode!=='resize')return;const dx=e.clientX-sx,dy=e.clientY-sy;let nw=sw,nh=sh,nl=sl,nt=st;if(dir.includes('r'))nw=Math.max(260,sw+dx);if(dir==='b'||dir==='br'||dir==='bl')nh=Math.max(240,sh+dy);if(dir.includes('l')&&dir!=='bl'){nw=Math.max(260,sw-dx);nl=sl+(sw-nw);}if(dir==='l'){nw=Math.max(260,sw-dx);nl=sl+(sw-nw);}if(dir==='bl'){nw=Math.max(260,sw-dx);nl=sl+(sw-nw);}if(dir.includes('t')){nh=Math.max(240,sh-dy);nt=st+(sh-nh);}const maxW=Math.min(window.innerWidth-12,700),maxH=Math.min(window.innerHeight-12,800);nw=Math.min(nw,maxW);nh=Math.min(nh,maxH);nl=Math.max(0,Math.min(window.innerWidth-nw-8,nl));nt=Math.max(0,Math.min(window.innerHeight-nh-8,nt));p.style.width=nw+'px';p.style.height=nh+'px';p.style.maxHeight='none';p.style.left=nl+'px';p.style.top=nt+'px';});
            document.addEventListener('mouseup',()=>{if(mode==='resize'){mode='';dir='';this._persistPos();}});
        },
        _persistPos(){try{localStorage.setItem('zh_prompt_pos',JSON.stringify({l:this.panel.style.left,t:this.panel.style.top,w:this.panel.style.width,h:this.panel.style.height}));}catch(e){}},
        _importMD(){const input=document.createElement('input');input.type='file';input.accept='.md,.markdown,.txt';input.style.display='none';input.onchange=()=>{const file=input.files[0];if(!file)return;const reader=new FileReader();reader.onload=()=>{const text=reader.result||'';const blocks=text.split(/^---+$/m).filter(b=>b.trim());let imported=0;blocks.forEach(block=>{const lines=block.trim().split('\n');const nameMatch=lines[0]?.match(/^#+\s*(.+)/);const name=nameMatch?nameMatch[1].trim():(lines[0]||'').trim();const content=nameMatch?lines.slice(1).join('\n').trim():lines.join('\n').trim();if(name&&content){this.prompts.push({id:Date.now()+imported,name:name,content:content});imported++;}});if(imported===0&&text.trim()){const fileName=file.name.replace(/\.(md|markdown|txt)$/i,'').trim()||'Imported';this.prompts.push({id:Date.now(),name:fileName,content:text.trim()});imported=1;}this.save();this.renderList();const tip=document.createElement('div');tip.style.cssText='position:fixed;top:50%;left:50%;transform:translate(-50%,-50%);background:#10b981;color:#fff;padding:10px 24px;border-radius:10px;font-size:13px;font-weight:700;z-index:2147483647;';tip.textContent=(currentLang==='zh'?'✅ 已导入 '+imported+' 条':'✅ Imported '+imported+' prompts');document.body.appendChild(tip);setTimeout(()=>tip.remove(),1800);};reader.readAsText(file);};document.body.appendChild(input);input.click();input.remove();},
        _exportMD(){this.load();if(!this.prompts.length){alert(currentLang==='zh'?'暂无 Prompt 可导出':'No prompts to export');return;}let md='# Prompt Library\n\n';this.prompts.forEach((p,i)=>{md+='## '+p.name+'\n\n'+p.content+'\n\n';if(i<this.prompts.length-1)md+='---\n\n';});const blob=new Blob([md],{type:'text/markdown'});const url=URL.createObjectURL(blob);const a=document.createElement('a');a.href=url;a.download='prompts-export.md';a.click();URL.revokeObjectURL(url);},
        toggleLock(){this.isLocked=!this.isLocked;const b=document.getElementById('zh-pp-lock');b.textContent=this.isLocked?T("lockPos"):T("unlockPos");b.classList.toggle('locked',this.isLocked);const h=this.panel?.querySelector('.zh-pp-hdr');if(h)h.style.cursor=this.isLocked?'default':'move';try{localStorage.setItem('zh_prompt_locked',String(this.isLocked));}catch(e){}},
        load(){try{const s=localStorage.getItem('zh_prompt_library');if(s)this.prompts=JSON.parse(s);}catch(e){}if(!Array.isArray(this.prompts))this.prompts=[];},
        save(){localStorage.setItem('zh_prompt_library',JSON.stringify(this.prompts));},
        toggle(){if(!this.panel)this.init();this.panel.classList.contains('visible')?this.hide():this.show();},
        show(){if(!this.panel)this.init();this.panel.classList.add('visible');this.renderList();},hide(){this.panel?.classList.remove('visible');},
        addPrompt(){const n=document.getElementById('zh-pp-name'),c=document.getElementById('zh-pp-content');if(!n.value.trim()||!c.value.trim()){alert(T("promptEmpty"));return;}this.prompts.push({id:Date.now(),name:n.value.trim(),content:c.value.trim()});this.save();n.value='';c.value='';this.renderList();},
        renderList(){const list=document.getElementById('zh-pp-list');if(!list)return;list.innerHTML='';if(!this.prompts.length){list.innerHTML='<div style="padding:20px;text-align:center;color:#94a3b8;font-size:12px;">'+T("noPrompts")+'</div>';return;}
            this.prompts.forEach((p,i)=>{const it=document.createElement('div');it.className='zh-pp-item';it.innerHTML='<div class="zh-pp-item-title">'+p.name+'</div><div class="zh-pp-item-preview">'+p.content.substring(0,80)+(p.content.length>80?'...':'')+'</div><div class="zh-pp-item-actions"><button class="use-btn">'+T("usePrompt")+'</button><button class="edit-btn">'+T("editPrompt")+'</button><button class="del-btn">'+T("deletePrompt")+'</button></div>';
                it.querySelector('.use-btn').onclick=()=>this._use(p);it.querySelector('.edit-btn').onclick=()=>{const nn=prompt(T("promptName"),p.name);if(nn===null)return;const nc=prompt(T("promptContent"),p.content);if(nc===null)return;if(nn.trim()&&nc.trim()){this.prompts[i]={...p,name:nn.trim(),content:nc.trim()};this.save();this.renderList();}};it.querySelector('.del-btn').onclick=()=>{if(confirm(T("promptConfirmDel"))){this.prompts.splice(i,1);this.save();this.renderList();}};list.appendChild(it);});
        },
        _use(p){let inp=document.querySelector('#prompt-textarea,textarea[data-id="root"],.ql-editor,[contenteditable="true"].ProseMirror,div[contenteditable="true"],textarea');if(!inp)inp=document.querySelector('textarea,[contenteditable="true"]');if(inp){if(inp.tagName==='TEXTAREA'||inp.tagName==='INPUT'){inp.focus();inp.value=p.content;inp.dispatchEvent(new Event('input',{bubbles:true}));}else{inp.focus();inp.innerHTML='';inp.appendChild(document.createTextNode(p.content));inp.dispatchEvent(new Event('input',{bubbles:true}));}this.hide();const t=document.createElement('div');t.style.cssText='position:fixed;top:50%;left:50%;transform:translate(-50%,-50%);background:#10b981;color:#fff;padding:10px 24px;border-radius:10px;font-size:13px;font-weight:700;z-index:2147483647;';t.textContent=T("promptInserted");document.body.appendChild(t);setTimeout(()=>t.remove(),1500);}}
    };
    // Clipboard bridge removed in V0.1 Git
    // Bootstrap
    function bootStrap(force){
        readPlatformEnabled((enabled)=>{
            extensionEnabled = enabled;
            if(!extensionEnabled){ destroyExtensionUI(); return; }
            applyUIFont();
            loadImportantMap();
            function ensurePanel(){if(!extensionEnabled)return;const p=document.getElementById('model-stats-panel'),m=document.getElementById('model-stats-mini');if(p&&document.documentElement.contains(p))return;if(p)p.remove();if(m)m.remove();try{createPanel();}catch(e){}}
            ensurePanel();
            if(!window.hasGptGuard){window.hasGptGuard=true;setInterval(ensurePanel,1500);}
            window.__acnIsDarkTheme=()=>{const cfg=getNavigatorSiteConfig();try{return!!cfg?.isDarkTheme?.();}catch(e){return false;}};
            loadMarkmapLibs();SidebarBookmarks.init();ChatHistoryPanel.init();PromptLibrary.init();
        });
    }
    if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',()=>setTimeout(()=>bootStrap(false),1000));else setTimeout(()=>bootStrap(false),500);
})();
