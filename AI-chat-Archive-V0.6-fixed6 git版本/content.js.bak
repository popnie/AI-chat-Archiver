    function destroyExtensionUI(){try{SidebarBookmarks.destroy();}catch(e){} try{ChatHistoryPanel.destroy();}catch(e){} try{document.querySelectorAll('.zh-prompt-panel,.chatgpt-timeline-bar,#zh-hover-panel,.mindmap-popup,#model-stats-panel,#model-stats-mini,.zh-sb-toggle').forEach(n=>n.remove());}catch(e){} try{document.body.classList.remove('zh-sidebar-page-shift');document.body.style.setProperty('--zh-sidebar-shift','0px');document.documentElement.classList.remove('zh-deepseek-shift');document.documentElement.style.setProperty('--zh-deepseek-shift','0px');}catch(e){} try{if(window.__zhPromptHintTimer){clearInterval(window.__zhPromptHintTimer);window.__zhPromptHintTimer=null;}}catch(e){}}
    function setExtensionEnabled(enabled){extensionEnabled=!!enabled; if(!extensionEnabled){destroyExtensionUI(); return;} setTimeout(()=>bootStrap(true),60);}
    const PLATFORM_MODELS = { 'chatgpt':['gpt-5-4-thinking','gpt-5-4'], 'gemini':['gemini pro 3.1'], 'claude':['claude sonnet 4.6','claude opus 4.6'], 'deepseek':['deepseek v3.2'], 'grok':['grok-3'], 'kimi':['kimi k2.5 thinking'], 'qwen':['qwen 3.5-plus thinking'] };
    const DEFAULT_MODEL_CONFIGS = { "gpt-5-4-thinking":{limit:3000,period:"周",resetHours:168}, "gpt-5-4":{limit:160,period:"3小时",resetHours:3}, "gemini pro 3.1":{limit:150,period:"2小时",resetHours:2}, "claude sonnet 4.6":{limit:150,period:"5小时",resetHours:5}, "claude opus 4.6":{limit:30,period:"5小时",resetHours:5}, "deepseek v3.2":{limit:"动态",period:"动态",resetHours:0}, "grok-3":{limit:"动态",period:"动态",resetHours:0}, "kimi k2.5 thinking":{limit:"动态",period:"动态",resetHours:0}, "qwen 3.5-plus thinking":{limit:"动态",period:"动态",resetHours:0} };
    let userPlanType="未知", modelStats={}, lastRequestTime={}, lastResetTime={}, isPanelCollapsed=false, currentPoW={difficulty:"unknown"}, chatFolders={"默认收藏":[]}, openFolderStates={};
