        footer.innerHTML='<a href="https://shiny.zhihuishuju.com/" target="_blank" style="text-decoration:none;text-align:center;display:flex;flex-direction:column;align-items:center;gap:4px;"><img src="https://github.com/popnie/jpg/blob/main/%E5%85%AC%E4%BC%97%E5%8F%B7%2B%E6%99%BA%E8%8D%9Flogo.png?raw=true" style="height:32px;"><div style="font-size:11px;color:#000;font-weight:bold;">'+T("medStat")+'</div></a><div style="text-align:center;display:flex;flex-direction:column;align-items:center;gap:4px;position:relative;"><img class="qr-hover-target" style="width:45px;height:45px;border-radius:12px;border:2px solid #fff;box-shadow:0 2px 8px rgba(0,0,0,0.05);" src="'+chrome.runtime.getURL('buy.png')+'"><div style="font-size:11px;color:#000;font-weight:bold;">'+T("officialAI")+'</div></div><div style="text-align:center;display:flex;flex-direction:column;align-items:center;gap:4px;position:relative;"><img class="qr-hover-target" style="transform-origin:bottom right;width:45px;height:45px;border-radius:12px;border:2px solid #fff;box-shadow:0 2px 8px rgba(0,0,0,0.05);" src="https://github.com/popnie/jpg/blob/main/%E6%88%91%E7%9A%84%E5%85%AC%E4%BC%97%E5%8F%B7%E4%BA%8C%E7%BB%B4%E7%A0%81.jpg?raw=true"><div style="font-size:11px;color:#000;font-weight:bold;">'+T("wxPub")+'</div></div>';
        wrap.append(titleRow,content,hints,tools,footer);
