        const panel=document.createElement('div');panel.id='model-stats-panel';panel.className='zh-floating-ui';Object.assign(panel.style,{position:'fixed',top:'20px',right:'40px',width:'280px',backgroundColor:'#fff',boxShadow:'0 20px 40px rgba(0,0,0,0.1)',borderRadius:'20px',zIndex:'10000',fontFamily:'var(--zh-ui-font)',display:'flex',flexDirection:'column',maxHeight:'94vh',transition:'transform 0.4s cubic-bezier(0.17,0.67,0.83,0.67)',border:'1px solid #f1f5f9'});
        const mini=document.createElement('div');mini.id='model-stats-mini';mini.className='zh-floating-ui';mini.innerHTML='<img src="https://github.com/popnie/jpg/blob/main/%E5%AE%9E%E6%88%98%E5%8C%BB%E5%AD%A6%E7%BB%9F%E8%AE%A1%E6%96%B0logo.png?raw=true" style="width:24px;height:24px;border-radius:6px;pointer-events:none;" alt="logo">';
        Object.assign(mini.style,{position:'fixed',top:'40px',right:'40px',width:'44px',height:'44px',backgroundColor:'#fff',boxShadow:'-4px 0 15px rgba(0,0,0,0.08)',borderRadius:'14px',zIndex:'9999',display:'flex',alignItems:'center',justifyContent:'center',cursor:'move',transition:'none',border:'1px solid #f1f5f9'});
        let _d=false,_sx=0,_sy=0,_ox=0,_oy=0,_mv=false,_pid=null;
        mini.addEventListener('pointerdown',e=>{_d=true;_pid=e.pointerId;_mv=false;_sx=e.clientX;_sy=e.clientY;const r=mini.getBoundingClientRect();_ox=r.left;_oy=r.top;try{mini.setPointerCapture(e.pointerId);}catch(err){}e.preventDefault();});
        document.addEventListener('pointermove',e=>{if(!_d)return;if(_pid!==null&&e.pointerId!==_pid)return;const dx=e.clientX-_sx,dy=e.clientY-_sy;if(Math.abs(dx)>3||Math.abs(dy)>3)_mv=true;mini.style.left=(_ox+dx)+'px';mini.style.top=(_oy+dy)+'px';mini.style.right='auto';});
        const finishMini=()=>{if(_d){_d=false;_pid=null;try{localStorage.setItem('zh_mini_pos',JSON.stringify({l:mini.style.left,t:mini.style.top}));}catch(e){}}};
        document.addEventListener('pointerup',finishMini);document.addEventListener('pointercancel',finishMini);
        try{const sv=JSON.parse(localStorage.getItem('zh_mini_pos'));if(sv){mini.style.left=sv.l;mini.style.top=sv.t;mini.style.right='auto';}}catch(e){}
        mini.onclick=e=>{if(_mv)return;SidebarBookmarks.toggle();};
