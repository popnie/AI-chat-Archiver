        const rd=document.createElement('div');rd.style.cssText='margin-bottom:16px;padding:12px;border-radius:14px;background:#f8fafc;border:1px solid #f1f5f9;display:flex;justify-content:center;align-items:center;gap:10px;';
        rd.innerHTML='<div style="font-weight:700;font-size:12px;color:#475569;">'+T("riskLabel")+'</div><div style="background:#fff;padding:4px 10px;border-radius:20px;display:flex;align-items:center;gap:6px;border:1px solid #e2e8f0;"><div style="width:10px;height:10px;border-radius:50%;background:'+lt.color+';box-shadow:0 0 8px '+lt.shadow+';"></div><span style="font-size:11px;font-weight:700;color:'+lt.color+';">'+lt.text+'</span></div>';
        frag.appendChild(rd);
        (PLATFORM_MODELS[currentPlatform]||[]).forEach(model=>{const m=modelStats[model]||{count:0,limit:DEFAULT_MODEL_CONFIGS[model]?.limit||"未知"};const dn=model==='gpt-5-4-thinking'?'gpt-5.4-thinking':model==='gpt-5-4'?'gpt-5.4-pro':model;const lim=m.limit==="无限"?"∞":m.limit;const pct=(typeof m.limit==='number'&&m.limit>0)?Math.min((m.count/m.limit)*100,100):0;const clr=pct>80?'#ef4444':pct>50?'#f59e0b':'#3b82f6';const el=document.createElement('div');el.style.cssText='margin-bottom:14px;padding-bottom:10px;border-bottom:1px solid #f1f5f9;';el.innerHTML='<div style="display:flex;justify-content:space-between;margin-bottom:6px;font-weight:700;font-size:12px;color:#1e293b;"><span>'+dn+'</span><span style="color:#64748b;">'+m.count+' / '+lim+'</span></div><div style="width:100%;height:5px;background:#f1f5f9;border-radius:10px;margin-bottom:6px;overflow:hidden;"><div style="height:100%;width:'+pct+'%;background:'+clr+';transition:width 0.5s;"></div></div><div style="display:flex;justify-content:space-between;font-size:10px;color:#94a3b8;"><span>'+T("lastPfx")+': '+fmtAgo(lastRequestTime[model])+'</span><span>'+T("resetPfx")+': '+calcReset(model)+'</span></div>';frag.appendChild(el);});
        box.innerHTML='';box.appendChild(frag);
    }
    // 11. Main Panel
    function createPanel(){
