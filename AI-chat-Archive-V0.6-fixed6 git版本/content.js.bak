    window.htmlToMarkdown_TD = window.htmlToMarkdown_TD || function(html) { if (__zhTurndown) return __zhTurndown.turndown(String(html || '')); return String(html || '').replace(/<[^>]+>/g, ' ').replace(/\s+/g, ' ').trim(); };
    function getNavigatorSiteConfig() { const configs = window.SITE_CONFIGS; if (!configs) return null; const url = window.location.href; for (const [key, cfg] of Object.entries(configs)) { if (cfg?.urlPatterns?.some((re) => re.test(url))) return cfg; } return configs[currentPlatform] || null; }
    try { chrome.runtime.onMessage.addListener((msg)=>{ if(msg.type==="langChange"&&msg.lang){ currentLang=msg.lang; try{localStorage.setItem("zhihui_lang",msg.lang);}catch(e){} const p=document.getElementById("model-stats-panel"),m=document.getElementById("model-stats-mini"); if(p)p.remove();if(m)m.remove(); if(typeof SidebarBookmarks!=='undefined')SidebarBookmarks.destroy(); applyUIFont(); bootStrap(true); } if(msg.type==="platformToggle"&&msg.platform===currentPlatform){ setExtensionEnabled(msg.enabled!==false); } }); } catch(e){}
    const host = window.location.hostname;
    let currentPlatform = 'chatgpt';
    if (host.includes('gemini.google.com')) currentPlatform = 'gemini'; else if (host.includes('claude.ai')) currentPlatform = 'claude'; else if (host.includes('chat.deepseek.com')) currentPlatform = 'deepseek'; else if (host.includes('grok.com')) currentPlatform = 'grok'; else if (host.includes('www.kimi.com') || host === 'kimi.com' || host.endsWith('.kimi.com')) currentPlatform = 'kimi'; else if (host.includes('chat.qwen.ai') || host === 'qwen.ai' || host.endsWith('.qwen.ai')) currentPlatform = 'qwen';
