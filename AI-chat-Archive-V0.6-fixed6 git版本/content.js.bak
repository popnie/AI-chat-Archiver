    let markmapLoaded = false;
    function injectPageScript(p){return new Promise((r,j)=>{const s=document.createElement('script');s.src=chrome.runtime.getURL(p);s.onload=()=>{s.remove();r();};s.onerror=j;(document.head||document.documentElement).appendChild(s);})}
    function injectPageCSS(p){return new Promise((r,j)=>{const l=document.createElement('link');l.rel='stylesheet';l.href=chrome.runtime.getURL(p);l.onload=r;l.onerror=j;document.head.appendChild(l);})}
    async function loadMarkmapLibs(){if(markmapLoaded)return;try{await injectPageCSS('libs/markmap-toolbar.css');await injectPageCSS('libs/default.min.css');await injectPageScript('libs/d3.min.js');await injectPageScript('libs/highlight.min.js');await injectPageScript('libs/markmap-lib.js');await injectPageScript('libs/markmap-view.js');await injectPageScript('libs/markmap-toolbar.js');await injectPageScript('libs/markmap-view-patch.js');await injectPageScript('libs/markmap-bridge.js');markmapLoaded=true;window.dispatchEvent(new Event('markmap:loaded'));}catch(e){}}
    // CSS (V1.9)
    function injectStyles(){
        if(document.getElementById('ai-timeline-styles'))return;
        const s=document.createElement('style');s.id='ai-timeline-styles';
        s.textContent=`
:root{--tl-dot-color:#D1D5DB;--tl-dot-active:#10A37F;--tl-bg:rgba(240,240,240,0.8);--zh-ui-font:"Times New Roman",Times,Microsoft YaHei,"微软雅黑",sans-serif;--zh-deepseek-shift:0px;}
@media(prefers-color-scheme:dark){:root{--tl-dot-color:#555;--tl-bg:rgba(50,50,50,0.8);}}
.chatgpt-timeline-bar{position:fixed;top:80px;right:2px;width:34px;height:calc(100vh - 160px);z-index:2147483646;display:flex;flex-direction:column;align-items:center;border-radius:22px;background:linear-gradient(180deg,rgba(255,255,255,.88),rgba(255,247,237,.82));border:1px solid rgba(245,158,11,.18);backdrop-filter:blur(10px);box-shadow:0 16px 34px rgba(15,23,42,.08);transition:opacity .3s,box-shadow .25s;overflow:hidden;}
.chatgpt-timeline-bar:hover{box-shadow:0 16px 32px rgba(251,146,60,.14);}
.timeline-bar-handle{width:100%;height:24px;display:flex;align-items:center;justify-content:center;cursor:grab;background:linear-gradient(180deg,rgba(255,237,213,.95),rgba(255,247,237,.6));border-bottom:1px solid rgba(253,186,116,.45);color:#ea580c;font-size:12px;font-weight:800;user-select:none;letter-spacing:1px;}
.timeline-bar-handle:active{cursor:grabbing;}
.timeline-track{position:relative;width:100%;height:100%;flex:1;}.timeline-track-content{position:relative;width:100%;height:100%;}
.timeline-dot{position:absolute;left:50%;transform:translate(-50%,-50%);width:24px;height:24px;background:transparent;border:none;cursor:pointer;padding:0;outline:none;border-radius:999px;}
.timeline-dot::after{content:'';position:absolute;left:50%;top:50%;width:16px;height:16px;transform:translate(-50%,-50%);border-radius:999px;background:linear-gradient(135deg,#fdba74,#fb923c);box-shadow:0 8px 18px rgba(251,146,60,.20);transition:all .22s ease;}
.timeline-dot::before{content:'';position:absolute;left:50%;top:50%;width:8px;height:8px;transform:translate(-50%,-50%);background:#fff;border-radius:999px;z-index:1;transition:transform .22s ease,opacity .22s ease;}
.timeline-dot:hover::after,.timeline-dot.hovered::after{width:18px;height:18px;box-shadow:0 10px 20px rgba(251,146,60,.24);}
.timeline-dot:hover::before,.timeline-dot.hovered::before{transform:translate(-50%,-50%) scale(1.08);}
.timeline-dot.active::after{width:20px;height:20px;box-shadow:0 0 0 4px rgba(251,191,36,.14),0 10px 22px rgba(251,146,60,.28);}
.timeline-dot.active::before{transform:translate(-50%,-50%) scale(1.1);}.timeline-dot.important::after{background:linear-gradient(135deg,#ef4444,#dc2626);box-shadow:0 10px 22px rgba(220,38,38,.24);}.timeline-dot.important.active::after{box-shadow:0 0 0 4px rgba(248,113,113,.14),0 12px 24px rgba(220,38,38,.26);}.timeline-dot.important::before{content:"🌟";background-image:none;color:#fff;font-size:10px;font-weight:900;display:flex;align-items:center;justify-content:center;}
.tl-hover-panel{position:fixed;right:48px;background:#fff;color:#1e293b;border-radius:18px;box-shadow:0 22px 48px rgba(15,23,42,.16);width:420px;min-width:320px;min-height:240px;max-width:min(92vw,760px);max-height:78vh;overflow:hidden;pointer-events:none;visibility:hidden;opacity:0;transition:opacity .22s,z-index .22s,visibility .22s;z-index:2147483647;border:1px solid #e2e8f0;display:flex;flex-direction:column;font-family:-apple-system,sans-serif;}
.tl-hover-panel.visible{opacity:1;pointer-events:auto;visibility:visible;}
.tl-hover-panel:not(.visible),.tl-hover-panel:not(.visible) *{pointer-events:none!important;}
.hp-dragbar{padding:10px 14px;background:linear-gradient(135deg,#fff7ed,#fffbeb);border-bottom:1px solid #fed7aa;font-size:11px;font-weight:800;color:#ea580c;cursor:move;user-select:none;letter-spacing:.2px;display:flex;align-items:center;justify-content:space-between;gap:8px;}.hp-important-btn{border:none;background:#fff;border:1px solid #fecaca;color:#dc2626;border-radius:999px;padding:2px 10px;font-size:14px;line-height:1;cursor:pointer;box-shadow:0 4px 10px rgba(15,23,42,.06);}.hp-important-btn.active{background:linear-gradient(135deg,#ef4444,#dc2626);color:#fff;border-color:#ef4444;box-shadow:0 6px 14px rgba(220,38,38,.20);}.hp-question{padding:14px 16px;background:#fffaf5;font-weight:700;font-size:13px;color:#0f172a;min-height:88px;max-height:none;overflow:auto;white-space:pre-wrap;outline:none;flex:0 0 auto;}.hp-splitter{height:10px;cursor:row-resize;background:linear-gradient(180deg,#fffdf8,#f8fafc);border-top:1px solid #ffedd5;border-bottom:1px solid #e2e8f0;position:relative;flex-shrink:0;}.hp-splitter::after{content:'';position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);width:52px;height:4px;border-radius:999px;background:linear-gradient(90deg,#fdba74,#f59e0b);}
.hp-response{display:none!important;}.hp-outline{padding:10px 16px;overflow-y:auto;max-height:none;flex:1;min-height:76px;}.hp-outline-title{font-size:11px;font-weight:700;color:#94a3b8;margin-bottom:6px;}.hp-outline-item{font-size:11px;color:#475569;padding:3px 4px;cursor:pointer;border-radius:6px;}.hp-outline-item:hover{background:#f1f5f9;}.hp-outline-item.lv1{font-weight:700;}.hp-outline-item.lv2{padding-left:14px;}.hp-outline-item.lv3{padding-left:28px;font-size:10px;}
.hp-mm-btn{display:flex;align-items:center;justify-content:center;gap:6px;padding:10px 16px;margin:8px 16px 14px;background:#fff7ed;color:#1e293b;border:1px solid #fdba74;border-radius:12px;font-size:12px;font-weight:800;cursor:pointer;pointer-events:auto;box-shadow:0 6px 16px rgba(249,115,22,.10);}
.hp-resize-handle{position:absolute;z-index:4;}
.hp-resize-n{top:-5px;left:12px;width:calc(100% - 24px);height:10px;cursor:ns-resize;}
.hp-resize-s{bottom:-5px;left:12px;width:calc(100% - 24px);height:10px;cursor:ns-resize;}
.hp-resize-e{top:12px;right:-5px;width:10px;height:calc(100% - 24px);cursor:ew-resize;}
.hp-resize-w{top:12px;left:-5px;width:10px;height:calc(100% - 24px);cursor:ew-resize;}
.hp-resize-ne{top:-5px;right:-5px;width:16px;height:16px;cursor:nesw-resize;}
.hp-resize-nw{top:-5px;left:-5px;width:16px;height:16px;cursor:nwse-resize;}
.hp-resize-se{bottom:-5px;right:-5px;width:16px;height:16px;cursor:nwse-resize;}
.hp-resize-sw{bottom:-5px;left:-5px;width:16px;height:16px;cursor:nesw-resize;}
.zh-dynamic-prompt-hint{font-size:12px;font-weight:900;background:linear-gradient(135deg,#f97316,#ec4899,#8b5cf6);background-size:240% 240%;-webkit-background-clip:text;background-clip:text;color:transparent;animation:zhHintGlow 3s ease infinite;letter-spacing:.2px;}
@keyframes zhHintGlow{0%{background-position:0% 50%;transform:translateY(0);}50%{background-position:100% 50%;transform:translateY(-1px);}100%{background-position:0% 50%;transform:translateY(0);}}
.mindmap-popup{position:fixed;top:120px;left:50%;transform:translateX(-50%);width:min(860px,calc(100vw - 32px));height:min(620px,calc(100vh - 140px));border-radius:8px;box-shadow:0 2px 6px rgba(0,0,0,0.15);z-index:2147483647;display:flex;flex-direction:column;background:#f7f7f8;color:#000;}.mindmap-header{padding:4px 12px;border-radius:8px 8px 0 0;font-weight:500;font-size:14px;text-align:center;position:relative;user-select:none;background:#ececf1;cursor:move;}.mindmap-header span{display:block;text-align:center;}.mindmap-close-btn{background:transparent;border:none;font-size:18px;cursor:pointer;color:inherit;line-height:14px;opacity:0;transition:opacity 0.2s;position:absolute;right:10px;top:50%;transform:translateY(-50%);}.mindmap-header:hover .mindmap-close-btn{opacity:1;}.mindmap-content{flex:1;overflow:auto;padding:10px;background:#f7f7f8;color:#000;}.mindmap-content svg{width:100%;height:100%;}.mindmap-content .markmap-foreign{color:inherit;font-size:14px!important;}.mindmap-content .markmap-foreign div{color:inherit;font-size:14px!important;white-space:normal;overflow-wrap:anywhere;}.mindmap-resize-handle{position:absolute;right:0;bottom:0;width:14px;height:14px;cursor:se-resize;background:linear-gradient(135deg,transparent 50%,#cdcdd4 50%);border-radius:0 0 8px 0;}
@media(prefers-color-scheme:dark){.mindmap-popup{background:#343541;color:#fff;}.mindmap-header{background:#444654;}.mindmap-content{background:#343541;color:#fff;}.mindmap-content .markmap-foreign,.mindmap-content .markmap-foreign div{color:#fff;}}
.qr-hover-target{transition:transform 0.3s cubic-bezier(0.175,0.885,0.32,1.275);position:relative;z-index:100;cursor:zoom-in;transform-origin:bottom center;}.qr-hover-target:hover{transform:scale(3);z-index:999999!important;}
.folder-group{margin-bottom:6px;}.folder-header{display:flex;justify-content:space-between;align-items:center;padding:6px 8px;background:#f1f5f9;border-radius:6px;font-size:12px;font-weight:700;color:#334155;cursor:pointer;transition:all 0.15s;}.folder-header:hover{background:#e2e8f0;}.folder-items{display:none;padding-left:8px;margin-top:4px;}.folder-items.open{display:block;}
.folder-header.drag-over{background:#fef3c7!important;border:2px dashed #f59e0b!important;transform:scale(1.02);}
.chat-link-item{display:flex;justify-content:space-between;align-items:center;padding:4px 8px;font-size:11px;color:#475569;border-radius:4px;cursor:pointer;text-decoration:none;margin-bottom:2px;transition:background 0.2s;}.chat-link-item:hover{background:#f1f5f9;color:#0f172a;}.chat-link-text{white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:170px;}
.chat-delete-btn{color:#ef4444;background:none;border:none;cursor:pointer;font-size:12px;opacity:0;transition:opacity 0.2s;padding:0 4px;}.chat-link-item:hover .chat-delete-btn{opacity:1;}
.custom-scrollbar::-webkit-scrollbar{width:4px;}.custom-scrollbar::-webkit-scrollbar-track{background:transparent;}.custom-scrollbar::-webkit-scrollbar-thumb{background:#cbd5e1;border-radius:4px;}
body.zh-sidebar-page-shift{--zh-sidebar-shift:0px;}
body.zh-sidebar-page-shift>*:not(.zh-floating-ui){transition:transform .3s ease,margin .3s ease;transform:translateX(var(--zh-sidebar-shift));}
html.zh-deepseek-shift #root{transition:margin-left .3s ease,width .3s ease!important;margin-left:var(--zh-deepseek-shift,0px)!important;width:calc(100% - var(--zh-deepseek-shift,0px))!important;}
/* Fix1: Sidebar pushes page, resizable */
.zh-sidebar,.zh-prompt-panel,.zh-ch-panel,.zh-ch-btn,.chatgpt-timeline-bar,.timeline-hover-panel,.zh-floating-ui{font-family:var(--zh-ui-font)!important;}.zh-sidebar{position:fixed;top:0;left:0;width:280px;height:100vh;background:#fff;box-shadow:4px 0 20px rgba(0,0,0,0.08);z-index:2147483646;font-family:var(--zh-ui-font)!important;display:flex;flex-direction:column;transform:translateX(-100%);transition:transform 0.3s ease;border-right:1px solid #e2e8f0;}
.zh-sidebar.open{transform:translateX(0);}
.zh-sb-resize{position:absolute;top:0;right:-4px;width:8px;height:100%;cursor:ew-resize;z-index:10;}
.zh-sb-toggle{position:fixed;top:50%;left:0;transform:translateY(-50%);width:22px;height:64px;background:linear-gradient(135deg,#f59e0b,#ea580c);border:none;border-radius:0 10px 10px 0;cursor:pointer;z-index:2147483645;display:flex;align-items:center;justify-content:center;box-shadow:2px 2px 10px rgba(0,0,0,0.12);transition:all 0.3s;opacity:0.8;}.zh-sb-toggle:hover{opacity:1;width:26px;}
/* Fix2: Chat History resizable from all edges */
.zh-ch-btn{position:fixed;top:74px;right:30px;width:34px;height:34px;background:linear-gradient(135deg,#fb923c,#f59e0b);border:1px solid rgba(245,158,11,0.35);border-radius:999px;cursor:grab;z-index:2147483645;display:flex;align-items:center;justify-content:center;box-shadow:0 8px 18px rgba(245,158,11,0.22);touch-action:none;user-select:none;}.zh-ch-btn:hover{transform:scale(1.05);box-shadow:0 10px 22px rgba(245,158,11,0.28);}.zh-ch-btn.dragging{cursor:grabbing;transform:none!important;}
.zh-ch-panel{position:fixed;top:80px;right:40px;width:360px;height:440px;background:#fff;border-radius:14px;box-shadow:0 12px 40px rgba(0,0,0,0.15);z-index:2147483647;font-family:-apple-system,sans-serif;display:none;flex-direction:row;border:1px solid #e2e8f0;overflow:visible;min-width:260px;min-height:220px;}.zh-ch-panel.visible{display:flex;}
.zh-ch-tl{width:36px;background:#fffaf5;border-right:1px solid #fed7aa;display:flex;flex-direction:column;align-items:center;padding:8px 0;overflow-y:auto;flex-shrink:0;}.zh-ch-tl .dot{width:10px;height:10px;border-radius:50%;background:#fed7aa;margin:4px 0;cursor:pointer;transition:all 0.2s;flex-shrink:0;}.zh-ch-tl .dot:hover{background:#f59e0b;transform:scale(1.3);}
.zh-ch-list{flex:1;display:flex;flex-direction:column;overflow:hidden;}.zh-ch-hdr{padding:10px 14px;border-bottom:1px solid #e2e8f0;font-weight:700;font-size:13px;color:#0f172a;display:flex;justify-content:space-between;align-items:center;flex-shrink:0;background:#f8fafc;cursor:move;user-select:none;}.zh-ch-items{flex:1;overflow-y:auto;padding:6px 10px;}
.zh-ch-item{padding:8px 10px;font-size:12px;color:#475569;border-radius:8px;cursor:grab;transition:all 0.15s;margin-bottom:4px;border:1px solid transparent;display:flex;align-items:center;gap:8px;}.zh-ch-item:hover{background:#f1f5f9;border-color:#e2e8f0;}.zh-ch-item .idx{color:#94a3b8;font-weight:700;font-size:10px;width:20px;text-align:center;flex-shrink:0;}.zh-ch-item .txt{overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}.zh-ch-item.dragging{opacity:0.3;}
/* Window-style resize edges */
.zh-ch-edge{position:absolute;z-index:20;}
.zh-ch-edge-r{top:10px;right:-4px;width:8px;height:calc(100% - 20px);cursor:ew-resize;}
.zh-ch-edge-b{bottom:-4px;left:10px;width:calc(100% - 20px);height:8px;cursor:ns-resize;}
.zh-ch-edge-l{top:10px;left:-4px;width:8px;height:calc(100% - 20px);cursor:ew-resize;}
.zh-ch-edge-t{top:-4px;left:10px;width:calc(100% - 20px);height:8px;cursor:ns-resize;}
.zh-ch-edge-br{bottom:-4px;right:-4px;width:16px;height:16px;cursor:se-resize;}
.zh-ch-edge-bl{bottom:-4px;left:-4px;width:16px;height:16px;cursor:sw-resize;}
.zh-ch-edge-tr{top:-4px;right:-4px;width:16px;height:16px;cursor:ne-resize;}
.zh-ch-edge-tl{top:-4px;left:-4px;width:16px;height:16px;cursor:nw-resize;}
/* Prompt panel */
.zh-prompt-panel{position:fixed;top:100px;right:100px;width:360px;max-height:520px;background:#fff;border-radius:16px;box-shadow:0 16px 48px rgba(0,0,0,0.18);z-index:2147483647;font-family:-apple-system,sans-serif;display:none;flex-direction:column;border:1px solid #e2e8f0;overflow:visible;min-width:260px;min-height:240px;}.zh-prompt-panel.visible{display:flex;}
.zh-pp-hdr{padding:12px 16px;border-bottom:1px solid #e2e8f0;display:flex;justify-content:space-between;align-items:center;background:linear-gradient(135deg,#eff6ff,#f8fafc);flex-shrink:0;}
.zh-pp-add{padding:12px 16px;border-bottom:1px solid #f1f5f9;flex-shrink:0;}.zh-pp-add input,.zh-pp-add textarea{width:100%;box-sizing:border-box;padding:8px 10px;border:1px solid #e2e8f0;border-radius:8px;font-size:12px;margin-bottom:8px;outline:none;font-family:inherit;resize:vertical;}.zh-pp-add textarea{min-height:60px;max-height:120px;}.zh-pp-add button{width:100%;background:linear-gradient(135deg,#6366f1,#8b5cf6);color:#fff;border:none;border-radius:8px;padding:8px;font-size:12px;font-weight:700;cursor:pointer;}
.zh-pp-list{flex:1;overflow-y:auto;padding:8px 12px 12px;}.zh-pp-item{padding:10px 12px;background:#f8fafc;border:1px solid #e2e8f0;border-radius:10px;margin-bottom:8px;}.zh-pp-item:hover{border-color:#93c5fd;}
.zh-pp-item-title{font-weight:700;font-size:12px;color:#0f172a;margin-bottom:4px;}.zh-pp-item-preview{font-size:11px;color:#64748b;max-height:32px;overflow:hidden;margin-bottom:6px;}
.zh-pp-item-actions{display:flex;gap:6px;}.zh-pp-item-actions button{font-size:10px;padding:3px 10px;border-radius:6px;border:1px solid #e2e8f0;background:#fff;cursor:pointer;font-weight:600;}.zh-pp-item-actions .use-btn{background:#10b981;color:#fff;border-color:#10b981;}.zh-pp-item-actions .edit-btn{color:#3b82f6;border-color:#93c5fd;}.zh-pp-item-actions .del-btn{color:#ef4444;border-color:#fecaca;}
.zh-pp-lock-btn{background:none;border:1px solid #e2e8f0;border-radius:6px;padding:2px 8px;font-size:11px;cursor:pointer;color:#64748b;margin-right:6px;}.zh-pp-lock-btn.locked{color:#ef4444;border-color:#fecaca;background:#fff1f2;}
.zh-pp-resize{position:absolute;z-index:4;}.zh-pp-resize-r{top:10px;right:-4px;width:8px;height:calc(100% - 20px);cursor:ew-resize;}.zh-pp-resize-b{bottom:-4px;left:10px;width:calc(100% - 20px);height:8px;cursor:ns-resize;}.zh-pp-resize-l{top:10px;left:-4px;width:8px;height:calc(100% - 20px);cursor:ew-resize;}.zh-pp-resize-t{top:-4px;left:10px;width:calc(100% - 20px);height:8px;cursor:ns-resize;}.zh-pp-resize-br{bottom:-4px;right:-4px;width:16px;height:16px;cursor:se-resize;}.zh-pp-resize-bl{bottom:-4px;left:-4px;width:16px;height:16px;cursor:sw-resize;}.zh-pp-resize-tr{top:-4px;right:-4px;width:16px;height:16px;cursor:ne-resize;}.zh-pp-resize-tl{top:-4px;left:-4px;width:16px;height:16px;cursor:nw-resize;}
.zh-pp-io-row{display:flex;gap:6px;padding:0 16px 8px;}.zh-pp-io-row button{flex:1;font-size:10px;padding:5px 0;border-radius:6px;border:1px solid #e2e8f0;background:#f8fafc;cursor:pointer;font-weight:700;color:#475569;}.zh-pp-io-row button:hover{border-color:#93c5fd;color:#2563eb;}
        `;
        document.head.appendChild(s);
    }
    // 4. Nodes
    function firstExisting(ss){for(const s of ss){const e=document.querySelector(s);if(e)return e;}return null;}
    function queryAllUnique(ss){const o=[];const seen=new Set();ss.forEach(s=>{document.querySelectorAll(s).forEach(e=>{if(!seen.has(e)){seen.add(e);o.push(e);}});});return o;}
    function isVisible(el){if(!el||!document.documentElement.contains(el))return false;const s=window.getComputedStyle(el);if(s.display==='none'||s.visibility==='hidden')return false;const r=el.getBoundingClientRect();return(r.width>0||r.height>0);}
    function visibleUnique(ss){return queryAllUnique(ss).filter(isVisible);}
    function nearestBelow(u,ss,md=2600){const ut=u?.getBoundingClientRect?.().top||0;const c=visibleUnique(ss).filter(e=>e!==u);let b=null,bd=Infinity;c.forEach(e=>{const t=e.getBoundingClientRect().top;const d=t-ut;if(d>2&&d<bd&&d<md){b=e;bd=d;}});return b;}
    function getScrollContainer(){if(currentPlatform==='gemini')return document.querySelector('#chat-history,.chat-history-scroll-container')||document.documentElement;if(currentPlatform==='claude')return document.querySelector('.overflow-y-scroll.overflow-x-hidden.pt-6.flex-1')||document.querySelector('[class*="overflow-y-scroll"]:has([data-test-render-count])')||document.querySelector('.overflow-y-scroll')||document.documentElement;if(currentPlatform==='deepseek')return firstExisting(['[class*="conversation"]','[class*="chat-scroll"]','main'])||document.documentElement;if(currentPlatform==='kimi')return firstExisting(['[class*="chat-content"]','[class*="conversation"]','main'])||document.documentElement;if(currentPlatform==='qwen')return firstExisting(['[class*="chat-content"]','[class*="conversation"]','main'])||document.documentElement;if(currentPlatform==='grok')return firstExisting(['[class*="conversation"]','main'])||document.documentElement;let el=document.querySelector('article');while(el&&el!==document.body&&el!==document.documentElement){const s=window.getComputedStyle(el);if(s.overflowY==='auto'||s.overflowY==='scroll')return el;el=el.parentElement;}return document.documentElement;}
    function getUserQueries(){const cfg=getNavigatorSiteConfig();if(cfg?.selectors?.userMessage)return visibleUnique([cfg.selectors.userMessage]).filter(e=>(e.textContent||'').trim().length>0);if(currentPlatform==='chatgpt')return[...document.querySelectorAll('[data-message-author-role="user"]')];if(currentPlatform==='gemini')return[...document.querySelectorAll('user-query')];if(currentPlatform==='claude')return visibleUnique(['[data-testid="user-message"]','.font-user-message','[data-is-user="true"]']).filter(e=>(e.textContent||'').trim().length>0);if(currentPlatform==='deepseek')return visibleUnique(['[data-role="user"]','[class*="user-message"]','[class*="userBubble"]']);if(currentPlatform==='kimi')return visibleUnique(['[data-role="user"]','[class*="user-message"]','[class*="userBubble"]']);if(currentPlatform==='qwen')return visibleUnique(['[data-role="user"]','[class*="user-message"]','[class*="bubble-user"]']);if(currentPlatform==='grok')return visibleUnique(['[data-role="user"]','[class*="user-message"]']);return[];}
    function getAIResponseEl(u){if(!u)return null;const cfg=getNavigatorSiteConfig();if(cfg?.findResponse){try{const f=cfg.findResponse(u);if(f)return f;}catch(e){}}if(currentPlatform==='chatgpt')return u.closest('[data-testid^="conversation-turn-"]')?.nextElementSibling||u.parentElement?.nextElementSibling;if(currentPlatform==='gemini'){let s=u.nextElementSibling;while(s){if(s.tagName&&s.tagName.toLowerCase()==='model-response')return s;s=s.nextElementSibling;}return null;}if(currentPlatform==='claude')return nearestBelow(u,['[data-testid="assistant-message"]','.standard-markdown'])||null;if(currentPlatform==='deepseek')return nearestBelow(u,['[data-role="assistant"]','[class*="assistant-message"]','[class*="markdown"]'])||null;if(currentPlatform==='kimi')return nearestBelow(u,['[data-role="assistant"]','[class*="assistant-message"]','[class*="markdown"]'])||null;if(currentPlatform==='qwen')return nearestBelow(u,['[data-role="assistant"]','[class*="assistant-message"]','[class*="markdown"]'])||null;if(currentPlatform==='grok')return nearestBelow(u,['[data-role="assistant"]','[class*="assistant-message"]','[class*="markdown"]'])||null;return null;}
    function cleanOutlineText(t){let r=String(t||'').replace(/\s+/g,' ').trim();r=r.replace(/^(ChatGPT|Gemini|Claude|DeepSeek|Kimi|Qwen|Grok)\s*(said|says)?\s*[:：-]?\s*/i,'');r=r.replace(/^Show thinking\s*/i,'').replace(/^Thought for\s*\d+\s*seconds?\s*/i,'').replace(/^思考了\s*\d+\s*秒\s*/i,'').replace(/^已深度思考\s*\d+\s*秒\s*/i,'').replace(/^显示思考过程\s*/i,'').replace(/^Thinking\s*/i,'').replace(/^(Assistant|Model)\s*[:：-]?\s*/i,'');return r.trim();}
    function extractOutline(u){const cfg=getNavigatorSiteConfig();if(cfg?.getOutlineHeadings){try{const raw=cfg.getOutlineHeadings(u)||[];const m=raw.map(i=>({level:i.level||2,text:cleanOutlineText(i.text||'').substring(0,100),el:i.element||i.el||null})).filter(i=>i.text);if(m.length)return m.slice(0,15);}catch(e){}}const el=getAIResponseEl(u)||u;if(!el)return[];const items=[];const push=(l,t,n)=>{const x=cleanOutlineText(t||'').substring(0,100);if(x)items.push({level:l,text:x,el:n||el});};el.querySelectorAll('h1,h2,h3,h4,h5,h6').forEach(h=>{push(parseInt(h.tagName[1],10)||2,h.textContent,h);});if(items.length)return items.slice(0,15);el.querySelectorAll('li').forEach((li,i)=>{if(i<12)push(2,li.textContent,li);});return items.slice(0,15);}
    function openMindmap(uEl,aEl,i){const cfg=getNavigatorSiteConfig();const q=uEl?(uEl.innerText||'').trim():'';let md='';if(cfg?.getResponseFormatted){try{md=cfg.getResponseFormatted(uEl,'markdown')||'';}catch(e){}}if(!md&&aEl){md=window.htmlToMarkdown_TD?window.htmlToMarkdown_TD(aEl.innerHTML||''):(aEl.innerText||'').trim();}if(!md){alert('未提取到内容');return;}const go=()=>window.MindmapUtils.generateMindmap(q,md,i+1,true);if(window.MindmapUtils?.generateMindmap)go();else setTimeout(()=>{if(window.MindmapUtils?.generateMindmap)go();else alert('引擎加载中');},1500);}
    function getImportantStoreKey(url=getCurrentConversationHref()){return [currentPlatform,url||window.location.href].join('::');}
    function loadImportantMap(){try{importantMessageMap=JSON.parse(localStorage.getItem('zh_important_messages')||'{}')||{};}catch(e){importantMessageMap={};}}
    function saveImportantMap(){try{localStorage.setItem('zh_important_messages',JSON.stringify(importantMessageMap));}catch(e){}}
    function getImportantSet(url=getCurrentConversationHref()){const key=getImportantStoreKey(url);const raw=importantMessageMap[key];return new Set(Array.isArray(raw)?raw.map(v=>String(v)):[]);}
    function isMessageImportant(index,url=getCurrentConversationHref()){return getImportantSet(url).has(String(index));}
    function ensureDefaultFolder(){if(!chatFolders['默认收藏'])chatFolders['默认收藏']=[];}
    function saveImportantConversation(index,title,url=getCurrentConversationHref()){ensureDefaultFolder();const raw=stripYouSaid(title||T('unnamed'))||T('unnamed');const item={id:['important',currentPlatform,url,index,raw].join('::'),title:'🌟 '+raw,rawTitle:raw,url:url,messageIndex:Number(index),platform:currentPlatform,source:'important-message'};const exists=chatFolders['默认收藏'].find(c=>(c.id&&c.id===item.id)||((c.url===item.url)&&((c.messageIndex??0)===(item.messageIndex??0))));if(!exists){chatFolders['默认收藏'].unshift(item);openFolderStates['默认收藏']=true;FM.save();FM.render();}}
    function removeImportantConversation(index,url=getCurrentConversationHref()){ensureDefaultFolder();chatFolders['默认收藏']=chatFolders['默认收藏'].filter(c=>!(c&&c.source==='important-message'&&c.url===url&&Number(c.messageIndex)===Number(index)));FM.save();FM.render();}
    function toggleImportantMessage(index,title,url=getCurrentConversationHref()){loadImportantMap();const key=getImportantStoreKey(url);const set=getImportantSet(url);const token=String(index);let important=false;if(set.has(token)){set.delete(token);important=false;removeImportantConversation(index,url);}else{set.add(token);important=true;saveImportantConversation(index,title,url);}importantMessageMap[key]=Array.from(set);saveImportantMap();try{VisualTimeline.update();}catch(e){}try{ChatHistoryPanel.updateList();}catch(e){}return important;}
    // 6. Counting
    let lastQueryCount=-1,lastIncrementTime=0;
    function incrementLocalCount(mk){const now=Date.now();if(now-lastIncrementTime<3000)return;lastIncrementTime=now;if(!modelStats[mk])modelStats[mk]={count:0,limit:DEFAULT_MODEL_CONFIGS[mk]?.limit||0};if(!lastResetTime[mk])lastResetTime[mk]=now;const ms=(DEFAULT_MODEL_CONFIGS[mk]?.resetHours||2)*3600000;if(now-lastResetTime[mk]>ms){modelStats[mk].count=0;lastResetTime[mk]=now;}modelStats[mk].count+=1;lastRequestTime[mk]=new Date().toISOString();localStorage.setItem('gptModelStats',JSON.stringify(modelStats));localStorage.setItem('gptLastRequestTime',JSON.stringify(lastRequestTime));localStorage.setItem('gptLastResetTime',JSON.stringify(lastResetTime));updateUIContent();}
    function checkNewQueriesForCounting(){if(currentPlatform==='chatgpt')return;const qs=getUserQueries(),c=qs.length;if(lastQueryCount===-1){lastQueryCount=c;return;}if(c>lastQueryCount){const mk=(PLATFORM_MODELS[currentPlatform]||[])[0];if(mk)incrementLocalCount(mk);}lastQueryCount=c;}
    // 7. Timeline
    let hoverHideTimer=null;
    const VisualTimeline={bar:null,trackContent:null,scrollContainer:null,dots:[],hoverIndex:-1,
        init(){injectStyles();if(document.querySelector('.chatgpt-timeline-bar'))return;this.bar=document.createElement('div');this.bar.className='chatgpt-timeline-bar zh-floating-ui';const grip=document.createElement('div');grip.className='timeline-bar-handle';grip.textContent='⋮⋮';grip.title=currentLang==='zh'?'拖动时间线':'Drag timeline';const t=document.createElement('div');t.className='timeline-track';this.trackContent=document.createElement('div');this.trackContent.className='timeline-track-content';t.appendChild(this.trackContent);this.bar.append(grip,t);document.documentElement.appendChild(this.bar);initTimelineBarInteractions(this.bar,grip);this.scrollContainer=getScrollContainer();if(this.scrollContainer){this.scrollContainer.addEventListener('scroll',()=>this.syncScroll(),{passive:true});}this.trackContent.addEventListener('mousemove',(e)=>this.handleTrackHover(e));this.trackContent.addEventListener('mouseleave',(e)=>this.scheduleHoverHide(e));this.bar.addEventListener('mouseleave',(e)=>this.scheduleHoverHide(e));if(!document.getElementById('zh-hover-panel')){const hp=document.createElement('div');hp.id='zh-hover-panel';hp.className='tl-hover-panel zh-floating-ui';hp.innerHTML='<div class="hp-dragbar" id="hp-drag"><span>✥ 拖动窗口 / 上下左右缩放</span><button class="hp-important-btn" id="hp-important" title="important">🤍</button></div><div class="hp-question" id="hp-q" contenteditable="true" spellcheck="false"></div><div class="hp-splitter" id="hp-split" title="上下拖动分界线"></div><div class="hp-outline" id="hp-o"><div class="hp-outline-title" id="hp-ot"></div><div id="hp-ol"></div></div><button class="hp-mm-btn" id="hp-mm">'+T("mindmapBtn")+'</button>';document.documentElement.appendChild(hp);initHoverPanelInteractions(hp);hp.addEventListener("mouseenter",()=>{hp._keep=true;if(hoverHideTimer){clearTimeout(hoverHideTimer);hoverHideTimer=null;}});hp.addEventListener("mouseleave",()=>{hp._keep=false;if(hoverHideTimer)clearTimeout(hoverHideTimer);hoverHideTimer=setTimeout(()=>{if(document.getElementById('zh-hover-panel')?._keep)return;hideHoverPanel();},650);});}},
        update(){if(!this.bar||!document.documentElement.contains(this.bar)){if(this.bar)this.bar.remove();this.init();}const qs=getUserQueries();this.trackContent.innerHTML='';this.dots=[];this.hoverIndex=-1;if(!qs.length){this.bar.style.opacity='0';this.bar.style.pointerEvents='none';return;}this.bar.style.opacity='1';this.bar.style.pointerEvents='auto';this.scrollContainer=getScrollContainer();const isDoc=(this.scrollContainer===document.body||this.scrollContainer===document.documentElement);const st=isDoc?window.scrollY:this.scrollContainer.scrollTop;const cTop=isDoc?0:this.scrollContainer.getBoundingClientRect().top;const ys=qs.map(e=>(e.getBoundingClientRect().top-cTop)+st);const f=ys[0],l=ys.length>1?ys[ys.length-1]:f+1;const sp=Math.max(1,l-f);qs.forEach((el,i)=>{let pct=((ys[i]-f)/sp)*100;pct=Math.max(2,Math.min(98,pct));const dot=document.createElement('button');dot.className='timeline-dot';if(isMessageImportant(i))dot.classList.add('important');dot.type='button';dot.style.top=pct+'%';dot.setAttribute('aria-label','Timeline '+(i+1));dot.addEventListener('mouseenter',()=>{if(hoverHideTimer){clearTimeout(hoverHideTimer);hoverHideTimer=null;}this.setHovered(i,true);showHoverPanel(el,i,dot);});dot.addEventListener('mouseleave',(e)=>this.scheduleHoverHide(e));dot.addEventListener('click',()=>{el.scrollIntoView({behavior:'smooth',block:'center'});showHoverPanel(el,i,dot);});this.trackContent.appendChild(dot);this.dots.push({index:i,dot,el,y:ys[i]});});this.syncScroll();},
        setHovered(i,f){this.hoverIndex=i;this.dots.forEach(d=>{d.index===i?d.dot.classList.add('hovered'):d.dot.classList.remove('hovered');});if(i===-1&&!f){const hp=document.getElementById('zh-hover-panel');if(hp&&!hp._keep)hp.classList.remove('visible');}},
        scheduleHoverHide(e){const n=e?.relatedTarget;const hp=document.getElementById('zh-hover-panel');if(n&&((hp&&hp.contains(n))||(this.bar&&this.bar.contains(n))))return;if(hoverHideTimer)clearTimeout(hoverHideTimer);hoverHideTimer=setTimeout(()=>{if(document.getElementById('zh-hover-panel')?._keep)return;hideHoverPanel();},650);},
        handleTrackHover(e){if(!this.dots.length)return;if(hoverHideTimer){clearTimeout(hoverHideTimer);hoverHideTimer=null;}let near=this.dots[0],min=Infinity;this.dots.forEach(d=>{const r=d.dot.getBoundingClientRect();const dist=Math.abs(r.top+r.height/2-e.clientY);if(dist<min){min=dist;near=d;}});if(!near)return;if(this.hoverIndex!==near.index){this.setHovered(near.index,true);showHoverPanel(near.el,near.index,near.dot);}},
        syncScroll(){if(!this.dots.length||!this.scrollContainer)return;const isDoc=(this.scrollContainer===document.body||this.scrollContainer===document.documentElement);const cTop=isDoc?0:this.scrollContainer.getBoundingClientRect().top;const st=isDoc?window.scrollY:this.scrollContainer.scrollTop;const ref=st+(isDoc?window.innerHeight:this.scrollContainer.clientHeight)*0.45;let a=0;for(let i=0;i<this.dots.length;i++){if((this.dots[i].el.getBoundingClientRect().top-cTop+st)<=ref)a=i;else break;}this.dots.forEach((d,i)=>{i===a?d.dot.classList.add('active'):d.dot.classList.remove('active');});}
    };
    function initTimelineBarInteractions(bar,grip){if(!bar||bar.dataset.dragInit==='1')return;bar.dataset.dragInit='1';const clamp=(v,min,max)=>Math.max(min,Math.min(max,v));const timelinePosKey='zh_timeline_bar_pos_v055';try{const saved=JSON.parse(localStorage.getItem(timelinePosKey)||'null');if(saved&&typeof saved.left==='number'&&typeof saved.top==='number'){bar.style.left=saved.left+'px';bar.style.top=saved.top+'px';bar.style.right='auto';}else{bar.style.left='';bar.style.top='80px';bar.style.right='2px';}}catch(e){bar.style.left='';bar.style.top='80px';bar.style.right='2px';}let dragging=false,startX=0,startY=0,baseLeft=0,baseTop=0;const onDown=(e)=>{if(e.target.closest('.timeline-dot'))return;dragging=true;const rect=bar.getBoundingClientRect();startX=e.clientX;startY=e.clientY;baseLeft=rect.left;baseTop=rect.top;bar.style.left=rect.left+'px';bar.style.top=rect.top+'px';bar.style.right='auto';e.preventDefault();};(grip||bar).addEventListener('mousedown',onDown);document.addEventListener('mousemove',e=>{if(!dragging)return;const maxLeft=Math.max(0,window.innerWidth-bar.offsetWidth-6);const maxTop=Math.max(0,window.innerHeight-bar.offsetHeight-6);bar.style.left=clamp(baseLeft+e.clientX-startX,0,maxLeft)+'px';bar.style.top=clamp(baseTop+e.clientY-startY,0,maxTop)+'px';});document.addEventListener('mouseup',()=>{if(!dragging)return;dragging=false;try{localStorage.setItem(timelinePosKey,JSON.stringify({left:parseFloat(bar.style.left)||0,top:parseFloat(bar.style.top)||0}));}catch(e){}});window.addEventListener('resize',()=>{if(!bar.style.left)return;const rect=bar.getBoundingClientRect();bar.style.left=Math.min(rect.left,Math.max(0,window.innerWidth-bar.offsetWidth-6))+'px';bar.style.top=Math.min(rect.top,Math.max(0,window.innerHeight-bar.offsetHeight-6))+'px';});}
    window.VisualTimeline=VisualTimeline;
    function initHoverPanelInteractions(hp){if(hp.dataset.dragInit==='1')return;hp.dataset.dragInit='1';const clamp=(v,min,max)=>Math.max(min,Math.min(max,v));const handles=['n','s','e','w','ne','nw','se','sw'];handles.forEach(dir=>{const h=document.createElement('div');h.className='hp-resize-handle hp-resize-'+dir;h.dataset.dir=dir;hp.appendChild(h);});const qBox=hp.querySelector('#hp-q');const splitter=hp.querySelector('#hp-split');const mmBtn=hp.querySelector('#hp-mm');try{const saved=JSON.parse(localStorage.getItem('zh_hover_panel_state')||'null');if(saved){if(saved.left!=null){hp.style.left=saved.left+'px';hp.style.right='auto';}if(saved.top!=null)hp.style.top=saved.top+'px';if(saved.width)hp.style.width=saved.width+'px';if(saved.height)hp.style.height=saved.height+'px';if(saved.questionHeight&&qBox)qBox.style.height=saved.questionHeight+'px';if(saved.userPositioned)hp.dataset.userPositioned='1';}}catch(e){}const persist=()=>{try{localStorage.setItem('zh_hover_panel_state',JSON.stringify({left:parseFloat(hp.style.left)||null,top:parseFloat(hp.style.top)||null,width:hp.offsetWidth,height:hp.offsetHeight,questionHeight:parseFloat(qBox?.style.height)||qBox?.offsetHeight||null,userPositioned:hp.dataset.userPositioned==='1'}));}catch(e){}};let mode='',dir='',startX=0,startY=0,baseLeft=0,baseTop=0,baseWidth=0,baseHeight=0,baseQuestionHeight=0;const dragHandle=hp.querySelector('#hp-drag');dragHandle?.addEventListener('mousedown',e=>{mode='drag';const rect=hp.getBoundingClientRect();startX=e.clientX;startY=e.clientY;baseLeft=rect.left;baseTop=rect.top;hp.style.left=rect.left+'px';hp.style.top=rect.top+'px';hp.style.right='auto';hp.dataset.userPositioned='1';e.preventDefault();});splitter?.addEventListener('mousedown',e=>{mode='split';startY=e.clientY;baseQuestionHeight=qBox?.offsetHeight||120;hp.dataset.userPositioned='1';e.preventDefault();e.stopPropagation();});hp.querySelectorAll('.hp-resize-handle').forEach(handle=>handle.addEventListener('mousedown',e=>{mode='resize';dir=handle.dataset.dir||'';const rect=hp.getBoundingClientRect();startX=e.clientX;startY=e.clientY;baseLeft=rect.left;baseTop=rect.top;baseWidth=rect.width;baseHeight=rect.height;hp.style.left=rect.left+'px';hp.style.top=rect.top+'px';hp.style.width=rect.width+'px';hp.style.height=rect.height+'px';hp.style.right='auto';hp.dataset.userPositioned='1';e.preventDefault();e.stopPropagation();}));document.addEventListener('mousemove',e=>{if(!mode)return;const dx=e.clientX-startX,dy=e.clientY-startY;if(mode==='drag'){const maxLeft=Math.max(0,window.innerWidth-hp.offsetWidth-8);const maxTop=Math.max(0,window.innerHeight-hp.offsetHeight-8);hp.style.left=clamp(baseLeft+dx,0,maxLeft)+'px';hp.style.top=clamp(baseTop+dy,0,maxTop)+'px';return;}if(mode==='split'){if(!qBox)return;const minQuestion=88;const minOutline=76;const footerSpace=(mmBtn?.offsetHeight||52)+(splitter?.offsetHeight||10)+30;const maxQuestion=Math.max(minQuestion,(hp.clientHeight||baseHeight)-footerSpace-minOutline);qBox.style.height=clamp(baseQuestionHeight+dy,minQuestion,maxQuestion)+'px';return;}const minW=320,minH=240,maxW=Math.min(window.innerWidth-12,760),maxH=window.innerHeight-12;let nextLeft=baseLeft,nextTop=baseTop,nextWidth=baseWidth,nextHeight=baseHeight;if(dir.includes('e'))nextWidth=clamp(baseWidth+dx,minW,maxW);if(dir.includes('s'))nextHeight=clamp(baseHeight+dy,minH,maxH);if(dir.includes('w')){nextWidth=clamp(baseWidth-dx,minW,maxW);nextLeft=baseLeft+(baseWidth-nextWidth);}if(dir.includes('n')){nextHeight=clamp(baseHeight-dy,minH,maxH);nextTop=baseTop+(baseHeight-nextHeight);}nextLeft=clamp(nextLeft,0,window.innerWidth-nextWidth-8);nextTop=clamp(nextTop,0,window.innerHeight-nextHeight-8);hp.style.left=nextLeft+'px';hp.style.top=nextTop+'px';hp.style.width=nextWidth+'px';hp.style.height=nextHeight+'px';if(qBox&&parseFloat(qBox.style.height||'0')){const minQuestion=88;const minOutline=76;const footerSpace=(mmBtn?.offsetHeight||52)+(splitter?.offsetHeight||10)+30;const maxQuestion=Math.max(minQuestion,nextHeight-footerSpace-minOutline);qBox.style.height=clamp(parseFloat(qBox.style.height),minQuestion,maxQuestion)+'px';}});document.addEventListener('mouseup',()=>{if(!mode)return;mode='';dir='';persist();});}
    function buildBookmarkItem(rawTitle,index){const clean=stripYouSaid(String(rawTitle||'').replace(/\n/g,' ').trim())||T("unnamed");const display='Q'+(index+1)+' · '+(clean.length>42?clean.substring(0,42)+'...':clean);return {id:[window.location.pathname,index,clean].join('::'),title:display,rawTitle:clean,url:window.location.href,messageIndex:index,platform:currentPlatform};}
    function getCurrentConversationRow(){
        const selectors=['nav [aria-current="page"]','aside [aria-current="page"]','nav [aria-selected="true"]','aside [aria-selected="true"]','nav [data-active="true"]','aside [data-active="true"]','nav [data-state="active"]','aside [data-state="active"]','nav .active','aside .active','nav .selected','aside .selected'];
        for(const sel of selectors){const el=document.querySelector(sel);const row=findConversationDragRow(el);if(row)return row; if(el instanceof HTMLElement)return el;}
        const currentPath=location.pathname;
        const directCandidates=currentPlatform==='chatgpt'?getChatGPTConversationCandidates():[];
        for(const row of directCandidates){const href=getConversationHref(row);if(href){try{const url=new URL(href,location.origin);if(url.pathname===currentPath)return row;}catch(e){}}if(isCurrentConversationRow(row))return row;}
        const selectorList=(getConversationDragSelectors()[currentPlatform]||[]).join(',');
        if(selectorList){
            for(const el of document.querySelectorAll(selectorList)){
                const row=findConversationDragRow(el)||el;
                const href=getConversationHref(row)||getConversationHref(el);
                if(href){
                    try{const url=new URL(href,location.origin);if(url.pathname===currentPath)return row;}catch(e){}
                }
                if(isCurrentConversationRow(row))return row;
            }
        }
        return null;
    }
    function getCurrentConversationHref(){
        try{
            const row=getCurrentConversationRow();
            const href=row?getConversationHref(row):'';
            if(href)return href;
            return location.origin+location.pathname+(location.search||'');
        }catch(e){return window.location.href;}
    }
    function getCurrentConversationTitle(){
        const row=getCurrentConversationRow();
        const rowTitle=extractConversationTitle(row);
        if(rowTitle&&rowTitle!==T("unnamed"))return rowTitle;
        const heading=normalizeConversationTitle(document.querySelector('main h1')?.innerText||document.querySelector('h1')?.innerText||'');if(heading&&heading!==T("unnamed"))return heading;
        let dt=String(document.title||'').replace(/\s*[|·-]\s*(ChatGPT|Claude|Gemini|DeepSeek|Kimi|Qwen|Grok)(?:\s.*)?$/i,'').replace(/\s*[-|·]\s*OpenAI.*$/i,'').trim();dt=normalizeConversationTitle(dt);if(dt&&dt!==T("unnamed"))return dt;const pathTitle=normalizeConversationTitle(location.pathname.split('/').filter(Boolean).pop()||'');return pathTitle||T("unnamed");}
    function isCurrentConversationRow(el){if(!(el instanceof Element))return false;try{if(el.matches?.('[aria-current="page"],[aria-selected="true"],[data-active="true"],[data-state="active"]'))return true;}catch(e){}const token=(el.getAttribute?.('class')||'')+' '+(el.getAttribute?.('data-state')||'');if(/\b(active|selected|current)\b/i.test(token))return true;const href=getConversationHref(el);if(href){try{const url=new URL(href,location.origin);if(url.pathname===location.pathname)return true;}catch(e){}}const rowTitle=extractConversationTitle(el);const heading=normalizeConversationTitle(document.querySelector('main h1')?.innerText||document.querySelector('h1')?.innerText||'');if(heading&&rowTitle&&rowTitle===heading)return true;let dt=String(document.title||'').replace(/\s*[|·-]\s*(ChatGPT|Claude|Gemini|DeepSeek|Kimi|Qwen|Grok)(?:\s.*)?$/i,'').replace(/\s*[-|·]\s*OpenAI.*$/i,'').trim();dt=normalizeConversationTitle(dt);return !!(dt&&rowTitle&&rowTitle===dt);}
    function buildCurrentConversationItem(){const title=getCurrentConversationTitle();const url=getCurrentConversationHref();return {id:['conv',currentPlatform,url,title].join('::'),title:title,rawTitle:title,url:url,messageIndex:-1,platform:currentPlatform,source:'sidebar-conversation'};}
function exportCurrentConversationFallback(){const qs=getUserQueries();let md='';qs.forEach((q,i)=>{md+='## Q'+(i+1)+': '+stripYouSaid((q.innerText||'').trim())+'\n\n';const a=getAIResponseEl(q);if(a)md+=(window.htmlToMarkdown_TD?window.htmlToMarkdown_TD(a.innerHTML):(a.innerText||''))+'\n\n---\n\n';});if(md){const b=new Blob([md],{type:'text/markdown'});const u=URL.createObjectURL(b);const a=document.createElement('a');a.href=u;a.download=currentPlatform+'-chat-export.md';a.click();URL.revokeObjectURL(u);}else alert('No content');}
    function extractReadableText(el){if(!el)return '';const parts=[];const walker=document.createTreeWalker(el, NodeFilter.SHOW_TEXT, {acceptNode(node){const parent=node.parentElement;if(!parent)return NodeFilter.FILTER_REJECT;const tag=(parent.tagName||'').toLowerCase();if(['button','svg','path','img','script','style'].includes(tag))return NodeFilter.FILTER_REJECT;const txt=String(node.nodeValue||'').replace(/\s+/g,' ').trim();if(!txt)return NodeFilter.FILTER_REJECT;if(/^(更多|more|menu|open menu|删除|rename|pin|share)$/i.test(txt))return NodeFilter.FILTER_REJECT;return NodeFilter.FILTER_ACCEPT;}});let n;while((n=walker.nextNode())){const txt=String(n.nodeValue||'').replace(/\s+/g,' ').trim();if(txt)parts.push(txt);}return parts.join(' ').replace(/\s+/g,' ').trim();}
    function normalizeConversationTitle(text){let t=stripYouSaid(String(text||'').replace(/\s+/g,' ').trim());t=t.replace(/^(ChatGPT|Gemini|Claude|DeepSeek|Kimi|Qwen|Grok)\s*/i,'').trim();t=t.replace(/^(new chat|new conversation|新建聊天|新对话)$/i,'').trim();return t||T("unnamed");}
    function isIgnoredSidebarLabel(text){const t=String(text||'').replace(/\s+/g,' ').trim().toLowerCase();if(!t)return true;return /^(new chat|search chats|search|library|gpts|explore gpts|projects|project|settings|help|today|yesterday|previous 7 days|previous 30 days|more|upgrade plan|codex|images|apps|deep research|最近|今天|昨天|一周内|一个月内|更多|新聊天|搜索聊天|搜索|项目|设置|帮助|升级|应用|图片|深度研究|gpt)$/i.test(t);}
    function isLikelyChatGPTConversationRow(el){if(!(el instanceof HTMLElement))return false;if(el.closest('.zh-floating-ui'))return false;const text=normalizeConversationTitle(extractReadableText(el));if(!text||text===T("unnamed")||isIgnoredSidebarLabel(text))return false;const rect=el.getBoundingClientRect();if(rect.width<120||rect.height<18||rect.height>92)return false;const rawMeta=[el.id,el.getAttribute('data-testid'),el.getAttribute('data-path'),el.getAttribute('href'),el.getAttribute('aria-current'),el.getAttribute('aria-selected'),el.className].filter(Boolean).join(' ');if(/history-item|conversation|thread|chat-item|chatrow|chat-row|current|selected|\/c\/|\/g\//i.test(rawMeta))return true;const href=getConversationHref(el);if(href&&/(\/(c|g|chat)\/)/.test(href))return true;const scope=el.closest('nav,aside,[role="navigation"],[aria-label*="history" i],[aria-label*="chat" i],[data-testid*="history" i]');return !!scope;}
    function getChatGPTConversationCandidates(scope=document){const roots=scope instanceof Document?[...document.querySelectorAll('nav,aside,[role="navigation"],section,[data-testid*="history" i]')]:[scope];if(!roots.length)roots.push(document.body);const out=[];const seen=new Set();for(const root of roots){(root instanceof HTMLElement||root instanceof Document?root:document).querySelectorAll('a[href],button,li,[role="button"],[role="link"],div[data-testid],div[id],div').forEach(el=>{if(!(el instanceof HTMLElement)||seen.has(el))return;if(isLikelyChatGPTConversationRow(el)){seen.add(el);out.push(el);}});}return out;}
    function scrollToUserQuery(index){const qs=getUserQueries();const target=qs[Number(index)];if(target){target.scrollIntoView({behavior:'smooth',block:'center'});return true;}return false;}
    function getConversationDragSelectors(){return {chatgpt:['nav a[href*="/c/"]','nav a[href*="/g/"]','aside a[href*="/c/"]','aside a[href*="/g/"]','nav button[data-testid^="history-item-"]','nav button[data-testid="history-item"]','nav button[id^="history-item-"]','aside button[data-testid^="history-item-"]','aside button[data-testid="history-item"]','aside button[id^="history-item-"]','nav [data-testid^="history-item-"]','nav [data-testid="history-item"]','nav [id^="history-item-"]','aside [data-testid^="history-item-"]','aside [data-testid="history-item"]','aside [id^="history-item-"]','nav li','aside li','nav [role="listitem"]','aside [role="listitem"]','nav [data-testid*="conversation" i]','aside [data-testid*="conversation" i]','.conversation-item','[data-testid="conversation"]','[data-testid^="history-item-"]','[data-testid="history-item"]','[id^="history-item-"]'],gemini:['nav a[href*="/app/"]','nav a[href*="/chat"]','conversation-item','.conversation-title'],claude:['a[href*="/chat/"]','[data-testid*="chat"] a[href*="/chat/"]'],deepseek:['a[href*="/chat/"]','[class*="history"] a'],grok:['a[href*="/c/"]','a[href*="/chat/"]','[data-testid*="conversation"]'],kimi:['a[href*="/chat/"]','[class*="history"] a'],qwen:['a[href*="/chat/"]','[class*="history"] a']};}
    function extractConversationTitle(el){if(!(el instanceof Element))return T("unnamed");const direct=normalizeConversationTitle(el.getAttribute?.('aria-label')||el.getAttribute?.('title')||'');if(direct&&direct!==T("unnamed")&&!isIgnoredSidebarLabel(direct))return direct;const titleSelectors='[data-testid="conversation-title"], .truncate, .text-token-text-primary, .title, .conversation-title, [class*="title"], span, div';const candidates=[...el.querySelectorAll(titleSelectors)].map(n=>normalizeConversationTitle(n.innerText||n.textContent||'')).filter(Boolean).filter(t=>t!==T("unnamed")&&!isIgnoredSidebarLabel(t));if(candidates.length)return candidates.sort((a,b)=>b.length-a.length)[0];const ownText=normalizeConversationTitle(extractReadableText(el));return isIgnoredSidebarLabel(ownText)?T("unnamed"):(ownText||T("unnamed"));}
    function findConversationDragRow(node){if(!(node instanceof Element))return null;if(currentPlatform==='chatgpt'){const exact=node.closest('[data-testid^="history-item-"],[data-testid="history-item"],[id^="history-item-"],a[href*="/c/"],a[href*="/g/"]');if(exact instanceof HTMLElement)return exact;let cursor=node;for(let depth=0;cursor&&depth<8;depth+=1,cursor=cursor.parentElement){if(isLikelyChatGPTConversationRow(cursor))return cursor;}}const selectors=(getConversationDragSelectors()[currentPlatform]||[]);for(const sel of selectors){const match=node.closest(sel);if(match){const row=match.closest('a[href],button,li,[role="button"],[role="link"],[data-testid],div')||match;if(row instanceof HTMLElement)return row;}}const navFallback=node.closest('nav a,nav button,nav li,nav [role="button"],aside a,aside button,aside li,aside [role="button"],aside [data-testid],nav [data-testid]');if(navFallback instanceof HTMLElement){const text=normalizeConversationTitle(extractReadableText(navFallback));const href=getConversationHref(navFallback);if(text!==T("unnamed")||href)return navFallback;}return null;}
    function getConversationHref(el){const attrs=['href','data-href','data-url'];for(const attr of attrs){const own=el?.getAttribute?.(attr);if(own&&/^https?:/i.test(own))return own;if(own&&own.startsWith('/'))return location.origin+own;}const link=el?.closest?.('a[href]')||el?.querySelector?.('a[href]');try{if(link&&link.href)return link.href;}catch(e){}const candidates=[...(el?.querySelectorAll?.('a[href]')||[])];for(const a of candidates){try{if(a.href&&/(\/(c|chat|g)\/)/.test(a.href))return a.href;}catch(e){}}if(currentPlatform==='chatgpt'){const raw=[el?.id,el?.getAttribute?.('data-testid'),el?.dataset?.testid,el?.dataset?.conversationId,el?.getAttribute?.('data-conversation-id'),el?.dataset?.id,el?.getAttribute?.('data-id'),el?.outerHTML].filter(Boolean).join(' ');const m=raw.match(/([0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12})/i);if(m)return location.origin+'/c/'+m[1];}const pathLike=(el?.getAttribute?.('data-path')||el?.dataset?.path||'');if(pathLike)return /^https?:/i.test(pathLike)?pathLike:(pathLike.startsWith('/')?location.origin+pathLike:pathLike);return '';}
    function buildSidebarConversationItem(el){const row=findConversationDragRow(el)||el;if(currentPlatform==='chatgpt'&&!isLikelyChatGPTConversationRow(row)&&!isCurrentConversationRow(row))return null;let title=extractConversationTitle(row);let href='';try{href=getConversationHref(row)||getConversationHref(el)||'';}catch(e){}if((!title||title===T("unnamed"))&&isCurrentConversationRow(row))title=getCurrentConversationTitle();if(!href&&isCurrentConversationRow(row))href=getCurrentConversationHref();return {id:['conv',currentPlatform,href||title,title].join('::'),title:title||T("unnamed"),rawTitle:title||T("unnamed"),url:href||window.location.href,messageIndex:-1,platform:currentPlatform,source:'sidebar-conversation'};}
    function saveFolderState(){try{localStorage.setItem('zh_folder_open_states',JSON.stringify(openFolderStates));}catch(e){}}
    function showHoverPanel(u,i,dot){const hp=document.getElementById('zh-hover-panel');if(!hp)return;if(hoverHideTimer){clearTimeout(hoverHideTimer);hoverHideTimer=null;}let q=stripYouSaid(u.innerText.trim()).substring(0,500);const qEl=document.getElementById('hp-q');qEl.textContent='Q'+(i+1)+': '+q;hp.dataset.messageIndex=String(i);const ol=document.getElementById('hp-ol');ol.innerHTML='';document.getElementById('hp-ot').textContent=T("outlineTitle");const out=extractOutline(u);if(out.length)out.forEach(o=>{const d=document.createElement('div');d.className='hp-outline-item lv'+Math.min(o.level,4);d.textContent=o.text;d.onclick=()=>{if(o.el)o.el.scrollIntoView({behavior:'smooth',block:'center'});};ol.appendChild(d);});else ol.innerHTML='<div style="font-size:11px;color:#94a3b8;">'+T("noOutline")+'</div>';const imp=document.getElementById('hp-important');if(imp){const active=isMessageImportant(i);imp.textContent=active?'🌟':'🤍';imp.classList.toggle('active',active);imp.onclick=(ev)=>{ev.preventDefault();ev.stopPropagation();const next=toggleImportantMessage(i,q);imp.textContent=next?'🌟':'🤍';imp.classList.toggle('active',next);if(dot)dot.classList.toggle('important',next);};}const mm=document.getElementById('hp-mm');mm.textContent=T("mindmapBtn");mm.onclick=()=>{hideHoverPanel();const a=getAIResponseEl(u);if(a)openMindmap(u,a,i);};if(hp.dataset.userPositioned!=='1'){const r=dot.getBoundingClientRect();let top=r.top-80;if(top+Math.min(hp.offsetHeight||420,window.innerHeight-20)>window.innerHeight)top=Math.max(10,window.innerHeight-(hp.offsetHeight||420)-20);if(top<10)top=10;hp.style.left=(window.innerWidth-(hp.offsetWidth||420)-56)+'px';hp.style.top=top+'px';hp.style.right='auto';}else{if(!hp.style.left)hp.style.left=(window.innerWidth-(hp.offsetWidth||420)-56)+'px';if(!hp.style.top)hp.style.top='80px';hp.style.right='auto';}hp.classList.add('visible');}
    function hideHoverPanel(){const hp=document.getElementById('zh-hover-panel');if(hp){hp.classList.remove('visible');hp._keep=false;}VisualTimeline.setHovered(-1,false);if(hoverHideTimer){clearTimeout(hoverHideTimer);hoverHideTimer=null;}}
    // 8. DOM Optimizer
    const DOMOptimizer={isCollapsed:false,keepLatest:20,collapsedNodes:[],anchorNode:null,anchorParent:null,getNodes(){if(currentPlatform==='chatgpt')return[...new Set([...document.querySelectorAll("main [data-message-author-role], main article")].map(n=>n.closest('[data-testid^="conversation-turn-"]')||n).filter(Boolean))];if(currentPlatform==='gemini')return[...document.querySelectorAll('user-query, model-response')];if(currentPlatform==='claude')return visibleUnique(['.grid','[data-testid="user-message"]','[data-testid="assistant-message"]']);return queryAllUnique(['[data-role]','[class*="message"]']);},collapse(o,r){const n=this.getNodes();if(n.length<=this.keepLatest){alert(T("onlyN").replace("{n}",n.length));return;}const c=n.slice(0,n.length-this.keepLatest);this.anchorNode=n[n.length-this.keepLatest];this.anchorParent=this.anchorNode?.parentNode;this.collapsedNodes=c.map(n=>({node:n,parent:n.parentNode}));c.forEach(n=>n.remove());this.isCollapsed=true;o.style.display='none';r.style.display='block';r.querySelector('.badge').innerText=c.length;},restore(o,r){if(!this.isCollapsed)return;this.collapsedNodes.forEach(({node})=>{if(this.anchorNode&&this.anchorParent?.contains(this.anchorNode))this.anchorParent.insertBefore(node,this.anchorNode);});this.collapsedNodes=[];this.isCollapsed=false;o.style.display='block';r.style.display='none';VisualTimeline.update();}};
    // 9. FM
    const FM={load(){try{const s=localStorage.getItem('ai_universal_folders');if(s)chatFolders=JSON.parse(s);}catch(e){}try{const o=localStorage.getItem('zh_folder_open_states');if(o)openFolderStates=JSON.parse(o)||{};}catch(e){}if(!chatFolders["默认收藏"])chatFolders["默认收藏"]=[];},save(){localStorage.setItem('ai_universal_folders',JSON.stringify(chatFolders));saveFolderState();},render(){const c=document.getElementById('folder-list-container'),s=document.getElementById('folder-select');if(c&&s){c.innerHTML='';s.innerHTML='';Object.keys(chatFolders).forEach(fn=>{const o=document.createElement('option');o.value=fn;o.innerText=fn;s.appendChild(o);});}SidebarBookmarks.renderFolders();},addFolder(){const n=prompt(T("folderPrompt"));if(n&&n.trim()&&!chatFolders[n.trim()]){chatFolders[n.trim()]=[];openFolderStates[n.trim()]=true;this.save();this.render();}},exportFolders(){this.load();const payload={format:'ai-chat-archiver-bookmarks',version:'0.6',exportedAt:new Date().toISOString(),folders:chatFolders,openFolderStates:openFolderStates};const blob=new Blob([JSON.stringify(payload,null,2)],{type:'application/json'});const url=URL.createObjectURL(blob);const a=document.createElement('a');a.href=url;a.download='ai-chat-archiver-bookmarks-v0.6.json';a.style.display='none';document.documentElement.appendChild(a);a.click();setTimeout(()=>{URL.revokeObjectURL(url);a.remove();},1500);},saveChat(folder){const f=folder||(document.getElementById('zh-sb-folder-select')?.value);if(!f)return;const item=buildCurrentConversationItem();if(chatFolders[f]?.find(c=>(c.id&&c.id===item.id)||((c.url===item.url)&&((c.messageIndex??-1)===(item.messageIndex??-1))))){alert(T("alreadyIn"));return;}chatFolders[f].push(item);openFolderStates[f]=true;this.save();this.render();}};
    // 10. UI (Fix4: risk indicator for ALL platforms)
    function fmtAgo(ds){if(!ds)return T("neverUsed");const d=Math.floor((new Date()-new Date(ds))/1e3);if(d<60)return T("justNow");if(d<3600)return Math.floor(d/60)+T("minAgo");if(d<86400)return Math.floor(d/3600)+T("hrAgo");return Math.floor(d/86400)+T("dayAgo");}
    function calcReset(m){if(!modelStats[m]||!lastResetTime[m])return T("notUsed");const rh=(modelStats[m].resetHours??DEFAULT_MODEL_CONFIGS[m]?.resetHours??24);if(!rh||rh<=0)return DEFAULT_MODEL_CONFIGS[m]?.period||T("notUsed");const next=new Date(new Date(lastResetTime[m]).getTime()+rh*3600000);const d=Math.floor((next-new Date())/1e3);if(d<0)return T("aboutToReset");if(d<3600)return Math.floor(d/60)+T("minU");if(d<86400)return Math.floor(d/3600)+T("hrU");return Math.floor(d/86400)+T("dayU");}
    function getRiskLevel(platform){const models=PLATFORM_MODELS[platform]||[];let totalPct=0,count=0;models.forEach(m=>{const s=modelStats[m];const cfg=DEFAULT_MODEL_CONFIGS[m];if(s&&typeof s.limit==='number'&&s.limit>0){totalPct+=Math.min((s.count/s.limit)*100,100);count++;}});if(!count)return{color:"#94a3b8",text:T("detecting"),shadow:"rgba(148,163,184,0.3)"};const avg=totalPct/count;if(avg>80)return{color:"#e63946",text:T("highRisk"),shadow:"rgba(230,57,70,0.5)"};if(avg>50)return{color:"#f59e0b",text:T("medRisk"),shadow:"rgba(245,158,11,0.5)"};if(avg>25)return{color:"#84cc16",text:T("lowRisk"),shadow:"rgba(132,204,22,0.5)"};return{color:"#10b981",text:T("noRisk"),shadow:"rgba(16,185,129,0.5)"};}
    function getPowLight(diff){if(!diff||diff==="unknown")return{color:"#94a3b8",text:T("detecting"),shadow:"rgba(148,163,184,0.3)"};const c=diff.startsWith("0x")?diff.slice(2):diff;const l=c.replace(/^0+/,"").length;if(l<=2)return{color:"#e63946",text:T("highRisk"),shadow:"rgba(230,57,70,0.5)"};if(l===3)return{color:"#f59e0b",text:T("medRisk"),shadow:"rgba(245,158,11,0.5)"};if(l===4)return{color:"#84cc16",text:T("lowRisk"),shadow:"rgba(132,204,22,0.5)"};return{color:"#10b981",text:T("noRisk"),shadow:"rgba(16,185,129,0.5)"};}
    function loadData(){try{const ss=JSON.parse(localStorage.getItem('gptModelStats')||'{}'),sr=JSON.parse(localStorage.getItem('gptLastRequestTime')||'{}'),st=JSON.parse(localStorage.getItem('gptLastResetTime')||'{}'),sp=localStorage.getItem('gptUserPlanType');if(sp)userPlanType=sp;for(const m in ss){modelStats[m]=ss[m];if(sr[m])lastRequestTime[m]=sr[m];if(st[m])lastResetTime[m]=st[m];}for(const m in DEFAULT_MODEL_CONFIGS)if(!modelStats[m])modelStats[m]={count:0,limit:DEFAULT_MODEL_CONFIGS[m].limit};isPanelCollapsed=localStorage.getItem('gptPanelCollapsedState')==='true';}catch(e){}}
    function togglePanel(){isPanelCollapsed=!isPanelCollapsed;const p=document.getElementById('model-stats-panel'),m=document.getElementById('model-stats-mini');if(isPanelCollapsed){p.style.transform='translateX(calc(100% + 40px))';m.style.transform='translateX(0)';}else{p.style.transform='translateX(0)';m.style.transform='translateX(150%)';}localStorage.setItem('gptPanelCollapsedState',isPanelCollapsed);}
    function updateUIContent(){
        const content=document.getElementById('model-stats-content');if(!content)return;const frag=document.createDocumentFragment();
        // FIX4: Risk indicator for ALL platforms
        const lt=(currentPlatform==='chatgpt')?getPowLight(currentPoW.difficulty):getRiskLevel(currentPlatform);
        const rd=document.createElement('div');rd.style.cssText='margin-bottom:16px;padding:12px;border-radius:14px;background:#f8fafc;border:1px solid #f1f5f9;display:flex;justify-content:center;align-items:center;gap:10px;';
        rd.innerHTML='<div style="font-weight:700;font-size:12px;color:#475569;">'+T("riskLabel")+'</div><div style="background:#fff;padding:4px 10px;border-radius:20px;display:flex;align-items:center;gap:6px;border:1px solid #e2e8f0;"><div style="width:10px;height:10px;border-radius:50%;background:'+lt.color+';box-shadow:0 0 8px '+lt.shadow+';"></div><span style="font-size:11px;font-weight:700;color:'+lt.color+';">'+lt.text+'</span></div>';
        frag.appendChild(rd);
        (PLATFORM_MODELS[currentPlatform]||[]).forEach(model=>{const m=modelStats[model]||{count:0,limit:DEFAULT_MODEL_CONFIGS[model]?.limit||"未知"};const dn=model==='gpt-5-4-thinking'?'gpt-5.4-thinking':model==='gpt-5-4'?'gpt-5.4-pro':model;const lim=m.limit==="无限"?"∞":m.limit;const pct=(typeof m.limit==='number'&&m.limit>0)?Math.min((m.count/m.limit)*100,100):0;const clr=pct>80?'#ef4444':pct>50?'#f59e0b':'#3b82f6';const el=document.createElement('div');el.style.cssText='margin-bottom:14px;padding-bottom:10px;border-bottom:1px solid #f1f5f9;';el.innerHTML='<div style="display:flex;justify-content:space-between;margin-bottom:6px;font-weight:700;font-size:12px;color:#1e293b;"><span>'+dn+'</span><span style="color:#64748b;">'+m.count+' / '+lim+'</span></div><div style="width:100%;height:5px;background:#f1f5f9;border-radius:10px;margin-bottom:6px;overflow:hidden;"><div style="height:100%;width:'+pct+'%;background:'+clr+';transition:width 0.5s;"></div></div><div style="display:flex;justify-content:space-between;font-size:10px;color:#94a3b8;"><span>'+T("lastPfx")+': '+fmtAgo(lastRequestTime[model])+'</span><span>'+T("resetPfx")+': '+calcReset(model)+'</span></div>';frag.appendChild(el);});
        content.innerHTML='';content.appendChild(frag);
        renderSidebarTopContent();
    }
    function getDynamicPromptHints(){return [T("promptRightClick"), currentLang==='zh'?'✨ Prompt 支持右键秒速唤起':'✨ Open Prompts instantly with right-click', currentLang==='zh'?'🎯 Prompt 可编辑、拖动、收藏':'🎯 Prompts can be edited, dragged, and saved'];}
    function initDynamicPromptHints(scope=document){const nodes=[...scope.querySelectorAll('.zh-dynamic-prompt-hint')];if(!nodes.length)return;const hints=getDynamicPromptHints();let idx=0;nodes.forEach(n=>n.textContent=hints[0]);if(window.__zhPromptHintTimer)return;window.__zhPromptHintTimer=window.setInterval(()=>{const latest=getDynamicPromptHints();idx=(idx+1)%latest.length;document.querySelectorAll('.zh-dynamic-prompt-hint').forEach(n=>{n.textContent=latest[idx];});},2600);}
    function buildSidebarTopContent(){
